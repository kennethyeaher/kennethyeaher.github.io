---
import DeviceFrame from "@/components/DeviceFrame.astro";

// the shapes in src/data/coverDevices.mjs.
type DeviceScreen = { src: string; width: number; height: number };
type DevicePhone = DeviceScreen & { slot: "left" | "right" | "center"; island?: true };
type MacbookCover = { kind: "macbook"; figma: string; screen: DeviceScreen };
type PhonesCover = { kind: "phones"; figma: string; phones: DevicePhone[] };

interface Props {
  devices: MacbookCover | PhonesCover;
}
// devices on a home cover (figma 428:2684): a macbook, or three phones with the centre one on top. every length is
// figma's px on the 454px cover, written in cqi so the devices scale with the card. on hover the centre phone lifts 8px
// and the side phones fan out 6px, as the layer names say. the macbook instead expands as its demo timelines play
// (535:11620, 535:11652): it grows 1.12 times from its centre and drops 50px, so the base leaves the card and the screen
// fills it, 0.7s on the expo out curve going in and 0.7s on the ease in out curve coming back. the cover clips it.
const { devices } = Astro.props;

/** a figma length on the 454px cover as a share of the cover's width. */
function cq(px: number): string {
  return `${Number((px / 4.54).toFixed(3))}cqi`;
}

/** the inline box of an absolutely placed layer, from its figma x, y, width and height. */
function box(x: number, y: number, w: number, h: number): string {
  return `left: ${cq(x)}; top: ${cq(y)}; width: ${cq(w)}; height: ${cq(h)}`;
}

// phone frames from 439:2655, 439:2658 and 439:2661 (the same frames on sohive and terpcare): frame box and radius,
// the screen's inset and radius, and the island placed inside the frame.
const frames = {
  left: { x: 59, y: 52, w: 100, h: 217, r: 17, screenR: 14, island: [36, 7, 28, 7] },
  right: { x: 295, y: 52, w: 100, h: 217, r: 17, screenR: 14, island: [36, 7, 28, 7] },
  center: { x: 169, y: 24, w: 116, h: 252, r: 20, screenR: 16, island: [42, 8, 32, 8] },
} as const;
const inset = 4;

/** the layers of one phone: its frame, its screen and an optional island. */
function phoneLayers(phone: DevicePhone) {
  const frame = frames[phone.slot];
  const [islandX, islandY, islandW, islandH] = frame.island;
  return {
    frame: `${box(frame.x, frame.y, frame.w, frame.h)}; border-radius: ${cq(frame.r)}`,
    screen: `${box(inset, inset, frame.w - 2 * inset, frame.h - 2 * inset)}; border-radius: ${cq(frame.screenR)}`,
    island: `${box(islandX, islandY, islandW, islandH)}; border-radius: ${cq(5)}`,
  };
}
---
{devices.kind === "macbook" ? (
  <div class="cover-devices is-macbook" aria-hidden="true" data-figma={devices.figma}>
    {/* the Device/Laptop instance, 384 by 207.36 at x 35 and y 28: the elms page's macbook frame (the same component),
        whose lid, camera, bezel, base, notch and floor shadow are shares of its own width. */}
    <div class="device-macbook device-center" style={box(35, 28, 384, 207.36)}>
      <DeviceFrame frame="macbook" src={devices.screen.src} alt="" decorative width={devices.screen.width} height={devices.screen.height} />
    </div>
  </div>
) : (
  <div class="cover-devices is-phones" aria-hidden="true" data-figma={devices.figma}>
    {devices.phones.map((phone) => {
      const layers = phoneLayers(phone);
      return (
        <div class:list={["device-phone", `is-${phone.slot}`, { "device-center": phone.slot === "center" }]} style={layers.frame}>
          <img class="device-screen" src={phone.src} alt="" width={phone.width} height={phone.height} loading="lazy" decoding="async" style={layers.screen} />
          {phone.island && <span class="phone-island" style={layers.island}></span>}
        </div>
      );
    })}
  </div>
)}
<style>
  .cover-devices { position: absolute; z-index: 1; inset: 0; pointer-events: none; }
  .device-phone { position: absolute; overflow: hidden; background: #1b2026; box-shadow: 0 3.965cqi 8.811cqi rgb(0 0 0 / 35%); }
  /* the macbook draws its own floor shadow, so it takes none here. */
  .device-macbook { position: absolute; }
  .device-screen { position: absolute; max-width: none; object-fit: cover; }
  .device-phone .device-screen { object-position: top; }
  .phone-island { position: absolute; background: #0b0d10; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.project-card:is(:hover, :focus-visible)) .device-phone.device-center { translate: 0 -8px; }
    :global(.project-card:is(:hover, :focus-visible)) .device-phone.is-left { translate: -6px 0; }
    :global(.project-card:is(:hover, :focus-visible)) .device-phone.is-right { translate: 6px 0; }
    .device-phone { transition: translate 320ms var(--ease-out); }
    /* the expanded state follows focus, a click (exhibits.ts sets is-expanding as the case study opens), and hover only
       where a pointer hovers, so a touch's first tap expands and navigates at once and no hover sticks after it. */
    .device-macbook { transition: translate 0.7s cubic-bezier(0.65, 0, 0.35, 1), scale 0.7s cubic-bezier(0.65, 0, 0.35, 1); }
    :global(.project-card:is(:focus-visible, .is-expanding)) .device-macbook { translate: 0 11.013cqi; scale: 1.12; transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.project-card:hover) .device-macbook { translate: 0 11.013cqi; scale: 1.12; transition-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }
  }
</style>
