---
// project card linking the displayed work to its case study.
import ProjectCover from "@/components/ProjectCover.astro";

interface Props {
  project: {
    slug: string;
    cardTitle: string;
    year: string;
    cardImage: string;
    cardAlt: string;
    cover: {
      variant: string;
      poster: string;
      palette: string[];
      titlePlacement: string;
    };
  };
}

const { project } = Astro.props;
---

<a
  class="project-card"
  href={`/work/${project.slug}`}
  data-tilt-card
  data-cursor="card"
>
  <figure class="project-media">
    <ProjectCover project={project} />
  </figure>
  <div class="project-caption">
    <h3>{project.cardTitle}</h3>
    <span class="project-caption-slash" aria-hidden="true">/</span>
    <span class="project-year">{project.year}</span>
  </div>
</a>

<style>
  .project-card {
    display: block;
    min-width: 0;
  }

  .project-media {
    position: relative;
    overflow: hidden;
    margin: 0;
    aspect-ratio: 16 / 9;
    background: var(--surface);
  }

  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-media { transform: perspective(1000px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)); transition: transform 240ms var(--ease-out); }
  }

  .project-media::after {
    position: absolute;
    inset: 0;
    content: "";
    opacity: 0;
    background: radial-gradient(circle at var(--shine-x, 50%) var(--shine-y, 50%), rgb(255 255 255 / 18%), transparent 65%);
    transition: opacity 300ms ease;
  }

  /* home v3 caption (figma 176:1753, 177:1754): "{name} / {year}" in geist 15, 12px under the cover. the name is ink,
     the slash takes the breadcrumb's lighter tone, the year is muted. */
  .project-caption {
    display: flex;
    margin-top: 12px;
    align-items: baseline;
    gap: 8px;
    color: var(--muted);
    font: 15px / 20px var(--ui-sans);
  }

  .project-caption h3 {
    margin: 0;
    color: var(--ink);
    font: inherit;
    transition: color 220ms ease;
  }

  .project-caption-slash {
    color: color-mix(in srgb, var(--muted) 50%, var(--canvas));
  }

  .project-card:hover .project-media::after,
  .project-card:focus-visible .project-media::after {
    opacity: 1;
  }

  .project-card:hover .project-caption h3,
  .project-card:focus-visible .project-caption h3 {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-media :global(.project-cover) {
      transform: none !important;
    }
  }
</style>
