---
// project card linking the displayed work to its case study.
import ProjectCover from "@/components/ProjectCover.astro";

interface Props {
  project: {
    slug: string;
    cardTitle: string;
    category: string;
    year: string;
    role: string;
    summary: string;
    cardImage: string;
    cardAlt: string;
    cover: {
      variant: string;
      video: string;
      poster: string;
      palette: string[];
      titlePlacement: string;
      exhibit?: { src: string; alt: string; width: number; height: number; frame: "phone" | "tablet" | "laptop" | "sheet" };
    };
  };
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
---

<a
  class="project-card"
  href={`/work/${project.slug}`}
  data-tilt-card
>
  <figure class="project-media">
    <ProjectCover project={project} priority={priority} size="card" />
  </figure>
  <div class="project-heading">
    <h2 style={`view-transition-name: title-${project.slug}`}>{project.cardTitle}</h2>
    <span>{project.year}</span>
  </div>
  <p class="project-role">{project.category} · {project.role}</p>
  <p class="project-summary">{project.summary}</p>
</a>

<style>
  .project-card {
    display: block;
    min-width: 0;
  }

  .project-media {
    position: relative;
    overflow: hidden;
    margin: 0;
    aspect-ratio: 16 / 9;
    background: var(--surface);
  }

  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-media { transform: perspective(1000px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)); transition: transform 240ms var(--ease-out); }
  }

  .project-media::after {
    position: absolute;
    inset: 0;
    content: "";
    opacity: 0;
    background: radial-gradient(circle at var(--shine-x, 50%) var(--shine-y, 50%), rgb(255 255 255 / 18%), transparent 65%);
    transition: opacity 300ms ease;
  }

  .project-heading {
    display: flex;
    margin-top: 13px;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }

  .project-heading h2 {
    margin: 0;
    color: var(--ink-strong);
    font-family: var(--display);
    font-size: clamp(20px, 2vw, 27px);
    font-weight: 400;
    line-height: 1.15;
    transition: color 220ms ease;
  }

  .project-heading span,
  .project-role {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  .project-role {
    margin: 5px 0 0;
  }

  .project-summary {
    max-width: 62ch;
    margin: 9px 0 0;
    color: var(--secondary);
    font-size: 15px;
    line-height: 1.42;
  }

  .project-card:hover .project-media::after,
  .project-card:focus-visible .project-media::after {
    opacity: 1;
  }

  .project-card:hover .project-heading h2,
  .project-card:focus-visible .project-heading h2 {
    color: var(--accent);
  }

  @media (max-width: 620px) {
    .project-summary {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-media :global(.project-cover) {
      transform: none !important;
    }
  }
</style>
