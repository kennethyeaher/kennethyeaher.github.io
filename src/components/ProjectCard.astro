---
// project card linking the displayed work to its case study.
import ProjectCover from "@/components/ProjectCover.astro";

interface Props {
  project: {
    slug: string;
    cardTitle: string;
    category: string;
    year: string;
    role: string;
    summary: string;
    cardImage: string;
    cardAlt: string;
    cover: {
      variant: string;
      poster: string;
      palette: string[];
      titlePlacement: string;
    };
  };
}

const { project } = Astro.props;
---

<a
  class="project-card"
  href={`/work/${project.slug}`}
  data-tilt-card
>
  <figure class="project-media">
    <ProjectCover project={project} />
  </figure>
  <div class="project-heading">
    <h3>{project.cardTitle}</h3>
    <span>{project.year}</span>
  </div>
  <p class="project-role">{project.category} · {project.role}</p>
  <p class="project-summary">{project.summary}</p>
</a>

<style>
  .project-card {
    display: block;
    min-width: 0;
  }

  .project-media {
    position: relative;
    overflow: hidden;
    margin: 0;
    aspect-ratio: 16 / 9;
    background: var(--surface);
  }

  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .project-media { transform: perspective(1000px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)); transition: transform 240ms var(--ease-out); }
  }

  .project-media::after {
    position: absolute;
    inset: 0;
    content: "";
    opacity: 0;
    background: radial-gradient(circle at var(--shine-x, 50%) var(--shine-y, 50%), rgb(255 255 255 / 18%), transparent 65%);
    transition: opacity 300ms ease;
  }

  /* home v2 card meta (figma 131:1851, 131:1997): serif title and line, mono only for the year. */
  .project-heading {
    display: flex;
    margin-top: 20px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .project-heading h3 {
    margin: 0;
    color: var(--ink-strong);
    font-family: var(--display);
    font-size: clamp(26px, 2.22vw, 32px);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.1;
    transition: color 220ms ease;
  }

  .project-heading span {
    color: var(--muted);
    font: 12px / 1.3 var(--mono);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .project-role {
    margin: 8px 0 0;
    color: var(--color-muted-label);
    font: 15px / 1.3 var(--body);
  }

  .project-summary {
    margin: 8px 0 0;
    color: var(--ink);
    font-size: 17px;
    line-height: 1.5;
  }

  .project-card:hover .project-media::after,
  .project-card:focus-visible .project-media::after {
    opacity: 1;
  }

  .project-card:hover .project-heading h3,
  .project-card:focus-visible .project-heading h3 {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .project-heading {
      margin-top: 10px;
    }

    .project-role,
    .project-summary {
      margin-top: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-media :global(.project-cover) {
      transform: none !important;
    }
  }
</style>
