---
// photo journal: a simple masonry grid, no per-photo labels or captions.
interface GalleryItem {
  src: string;
  alt: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<section class="about-gallery" data-about-gallery aria-labelledby="photo-journal-title">
  <div class="gallery-heading" data-reveal>
    <p>Photo journal</p>
    <h2 id="photo-journal-title">The work is only one part of the person doing it.</h2>
  </div>
  <div class="gallery-grid">
    {
      items.map((item) => (
        <figure class="gallery-item" data-reveal>
          <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .about-gallery {
    margin-top: 116px;
  }

  .gallery-heading {
    display: grid;
    margin-bottom: 34px;
    grid-template-columns: minmax(160px, 0.5fr) minmax(0, 1.5fr);
    gap: 24px;
  }

  .gallery-heading p {
    margin: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  .gallery-heading h2 {
    max-width: 680px;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(32px, 4vw, 54px);
    font-weight: 400;
    line-height: 1.05;
  }

  .gallery-grid {
    column-count: 3;
    column-gap: 20px;
  }

  .gallery-item {
    margin: 0 0 20px;
    break-inside: avoid;
  }

  .gallery-item img {
    display: block;
    width: 100%;
    height: auto;
    background: #eceff2;
  }

  @media (max-width: 860px) {
    .gallery-grid {
      column-count: 2;
    }
  }

  @media (max-width: 620px) {
    .about-gallery {
      margin-top: 80px;
    }

    .gallery-grid {
      column-count: 1;
    }
  }
</style>
