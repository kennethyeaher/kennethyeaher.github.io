---
// shared navigation for the portfolio.
import { profile } from "@/data/portfolio.mjs";

interface Props {
  /** The case study title: the top left shows a breadcrumb back to Work instead of the name. */
  crumb?: string;
}

const { crumb } = Astro.props;

const links = [
  { href: "/", label: "Work" },
  { href: "/explore", label: "Explore" },
  { href: "/about", label: "About" },
  { href: profile.links.resume, label: "Resume", external: true },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

/** Return whether one internal navigation item represents the current route. */
function isActive(href: string): boolean {
  if (href === "/") return path === "/" || path.startsWith("/work/");
  if (href === "/explore") return path === href || path.startsWith("/explore/");
  return path === href;
}
---

{/* the v3 header (figma 176:1721, 177:1801): no bar and no rule, the name or a breadcrumb at the top left, and
    the cord hanging from the top edge at the top right. */}
<header class="site-header">
  {
    crumb ? (
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/"><span aria-hidden="true">←</span>Work</a>
        <span class="breadcrumb-slash" aria-hidden="true">/</span>
        <span class="breadcrumb-current" aria-current="page">{crumb}</span>
      </nav>
    ) : (
      <a class="brand-name" href="/">{profile.name}</a>
    )
  }
  {/* a fixed rail at the left edge (figma 176:1721), a row under the name at 980px and below, where the chapter rail
      hides too. case studies give the desktop spot to their chapter rail (figma 177:1801). the page links prefetch as
      soon as they show rather than on hover; the resume PDF never prefetches. */}
  <nav class:list={["site-nav", crumb && "is-case"]} aria-label="Primary navigation">
    <ul class="rail">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rail-link"
              aria-current={!link.external && isActive(link.href) ? "page" : undefined}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
              data-astro-prefetch={link.external ? "false" : "viewport"}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  {/* after the links, so focus reaches it last, matching where it hangs. */}
  <button class="theme-cord" type="button" data-theme-toggle data-cursor="cord" aria-label="Dark theme" aria-pressed="false">
    <span class="theme-cord-visual" aria-hidden="true"><span class="theme-cord-line"></span><span class="theme-cord-knob"></span></span>
  </button>
</header>
