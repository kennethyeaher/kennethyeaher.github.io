---
// desktop and mobile chapter wayfinding for a single case study.
interface Chapter {
  id: string;
  label: string;
}

interface Props {
  chapters: Chapter[];
}

// the v3 chapter rail (figma 177:1801): the shell's .rail and .rail-link in the same fixed spot, sentence case, with the
// square on the active chapter. the breadcrumb in the header replaces the old back link.
const { chapters } = Astro.props;
---

<aside class="case-rail" aria-label="Case study navigation" data-case-nav>
  <ol class="rail">
    {
      chapters.map((chapter, index) => (
        <li>
          <a
            class="rail-link"
            href={`#${chapter.id}`}
            data-section-link={chapter.id}
            aria-current={index === 0 ? "location" : undefined}
          >
            {chapter.label}
          </a>
        </li>
      ))
    }
  </ol>
</aside>

<div class="case-mobile-nav" data-case-nav>
  <label for="case-chapter-select">Jump to chapter</label>
  <select id="case-chapter-select" data-chapter-select>
    {chapters.map((chapter) => <option value={chapter.id}>{chapter.label}</option>)}
  </select>
</div>

<style>
  /* the aside keeps the layout's first column; its list takes the shell rail's spot (global.css .site-nav), which
     case studies hide on desktop. */
  .case-rail .rail {
    position: fixed;
    z-index: 10;
    top: 200px;
    left: calc(var(--page-gutter) - 10px);
  }

  .case-mobile-nav {
    display: none;
  }

  @media (max-width: 980px) {
    .case-rail {
      display: none;
    }

    .case-mobile-nav {
      display: grid;
      margin-bottom: 36px;
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 10px 18px;
    }

    .case-mobile-nav label {
      color: var(--muted);
      font-family: var(--mono);
      font-size: 11px;
      text-transform: uppercase;
    }

    .case-mobile-nav select {
      min-width: 180px;
      min-height: 44px;
      padding: 8px 34px 8px 12px;
      border: 1px solid var(--rule);
      border-radius: 0;
      background: var(--surface);
      color: var(--ink-strong);
    }
  }

  @media (max-width: 520px) {
    .case-mobile-nav {
      grid-template-columns: 1fr;
    }

    .case-mobile-nav select {
      width: 100%;
    }
  }
</style>
