---
// Compact resume-backed credibility list used beside the home thesis.
interface Props {
  entries: Array<{
    year: string;
    organization: string;
    role: string;
    /** one of the entries the phone layout keeps. */
    compact?: boolean;
  }>;
}

const { entries } = Astro.props;
---

<ol class="experience-list" aria-label="Selected experience">
  {
    entries.map((entry) => (
      <li class:list={[entry.compact && "is-compact"]}>
        <span class="experience-year">{entry.year}</span>
        <span class="experience-org">{entry.organization}</span>
        <span class="experience-role">{entry.role}</span>
      </li>
    ))
  }
</ol>

<style>
  /* home v2 (figma 131:1698, 131:1980): year, organisation and role in three columns; on phones the compact
     entries only, with the role under the organisation. */
  .experience-list {
    display: grid;
    margin: 0;
    padding: 0;
    gap: 6px;
    list-style: none;
  }

  .experience-list li {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    font-size: 17px;
    line-height: 1.5;
  }

  .experience-year,
  .experience-role {
    color: var(--muted);
  }

  .experience-year {
    font: 12px / 1.3 var(--mono);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .experience-org {
    color: var(--ink-strong);
  }

  @media (max-width: 760px) {
    .experience-list {
      gap: 10px;
    }

    .experience-list li {
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 12px;
    }

    .experience-list li:not(.is-compact) {
      display: none;
    }

    .experience-role {
      grid-column: 2;
    }
  }
</style>
