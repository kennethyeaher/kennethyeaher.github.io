---
import { coverFields } from "@/data/coverFields.mjs";

interface Props {
  project: {
    slug: string;
    cover: {
      variant: string;
    };
  };
}
// home card cover (figma 428:2684): square, no text, the cover frame's dark base under its blurred colour field.
// the caption under the card carries the name and year. devices and motion sit on top of this base.
const { project } = Astro.props;
const field = coverFields[project.slug];
if (!field) throw new Error(`No colour field for ${project.slug}`);

// figma's layer blur radius is twice the gaussian deviation css blur() takes, and it scales with the 454px cover.
const blur = `${(field.blur / 2 / 454 * 100).toFixed(3)}cqi`;

// each ellipse drifts a few percent of the cover and back, on its own direction and period, so the field never repeats in step.
const drifts = [[5, 4], [-4, 5], [-5, -3], [4, -5], [3, 4], [-3, -4]];

/** the inline style of one ellipse: its box as shares of the 454 by 256 cover, its fill, and its drift. */
function ellipseStyle({ x, y, r, colour, alpha }: { x: number; y: number; r: number; colour: string; alpha: number }, index: number): string {
  const [dx, dy] = drifts[index % drifts.length];
  const box = `left: ${((x - r) / 454 * 100).toFixed(3)}%; top: ${((y - r) / 256 * 100).toFixed(3)}%; width: ${(2 * r / 454 * 100).toFixed(3)}%`;
  return `${box}; background: ${colour}; opacity: ${alpha}; --drift-x: ${dx}cqi; --drift-y: ${dy}cqi; --drift-s: ${18 + index * 4}s`;
}
---
<div class:list={["project-cover", `cover-${project.cover.variant}`, "is-card"]}
  data-project-cover data-cover-variant={project.cover.variant} data-figma-field={field.figma}
  style={`--cover-base: ${field.base}`}>
  <div class="cover-gradient" aria-hidden="true" data-cover-gradient style={`--field-blur: ${blur}`}>
    {field.ellipses.map((ellipse, index) => <span class="cover-field" style={ellipseStyle(ellipse, index)}></span>)}
  </div>
  <slot />
</div>
<style>
  .project-cover { position: relative; overflow: hidden; width: 100%; height: 100%; isolation: isolate; container-type: inline-size; background: var(--cover-base); }
  .cover-gradient { position: absolute; z-index: 0; inset: 0; overflow: hidden; }
  /* one blurred ellipse per figma ellipse, each blurred on its own as figma draws them. */
  .cover-field { position: absolute; aspect-ratio: 1; border-radius: 50%; filter: blur(var(--field-blur)); }
  /* the slow drift runs only on screen (exhibits.ts sets is-live) and only when motion is welcome; otherwise the field is still. */
  @media (prefers-reduced-motion: no-preference) {
    .cover-field { animation: cover-field-drift var(--drift-s) ease-in-out infinite alternate; animation-play-state: paused; }
    .cover-gradient.is-live .cover-field { animation-play-state: running; }
  }
  @keyframes cover-field-drift { to { translate: var(--drift-x) var(--drift-y); } }
</style>
