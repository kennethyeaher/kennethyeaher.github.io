---
import CoverDevices from "@/components/CoverDevices.astro";
import CoverMotion from "@/components/CoverMotion.astro";
import { coverDevices } from "@/data/coverDevices.mjs";
import { coverFields } from "@/data/coverFields.mjs";
import { coverMotion } from "@/data/coverMotion.mjs";

interface Props {
  project: {
    slug: string;
    cover: {
      variant: string;
    };
  };
}
// home card cover (figma 428:2684): square, no text, the cover frame's dark base under its blurred colour field.
// the caption under the card carries the name and year. devices and motion sit on top of this base.
const { project } = Astro.props;
const field = coverFields[project.slug];
const devices = coverDevices[project.slug];
// a motion cover's layers; its timeline is src/styles/cover-motion/<slug>.css, which the home page imports.
const motion = coverMotion[project.slug];
if (!field) throw new Error(`No colour field for ${project.slug}`);

// figma's layer blur radius is twice the gaussian deviation css blur() takes, and it scales with the 454px cover.
const blur = `${(field.blur / 2 / 454 * 100).toFixed(3)}cqi`;

// each ellipse drifts a few percent of the cover and back, on its own direction and period, so the field never repeats in step.
const drifts = [[5, 4], [-4, 5], [-5, -3], [4, -5], [3, 4], [-3, -4]];

/** the inline style of one ellipse: its box as shares of the 454 by 256 cover, its fill, and its drift. */
function ellipseStyle({ x, y, r, colour, alpha }: { x: number; y: number; r: number; colour: string; alpha: number }, index: number): string {
  const [dx, dy] = drifts[index % drifts.length];
  const box = `left: ${((x - r) / 454 * 100).toFixed(3)}%; top: ${((y - r) / 256 * 100).toFixed(3)}%; width: ${(2 * r / 454 * 100).toFixed(3)}%`;
  return `${box}; background: ${colour}; opacity: ${alpha}; --drift-x: ${dx}cqi; --drift-y: ${dy}cqi; --drift-s: ${18 + index * 4}s`;
}
---
<div class:list={["project-cover", `cover-${project.cover.variant}`, "is-card"]}
  data-project-cover data-cover-variant={project.cover.variant} data-figma-field={field.figma} data-motion={motion ? project.slug : undefined}
  data-devices={devices?.kind} style={`--cover-base: ${field.base}`}>
  <div class="cover-gradient" aria-hidden="true" data-cover-gradient style={`--field-blur: ${blur}`}>
    {field.ellipses.map((ellipse, index) => <span class="cover-field" data-node={motion?.field[index]} style={ellipseStyle(ellipse, index)}></span>)}
  </div>
  {devices && <CoverDevices devices={devices} />}
  {motion && <CoverMotion root slug={project.slug} figma={motion.figma} layers={motion.layers} />}
  <slot />
</div>
<style>
  .project-cover { position: relative; overflow: hidden; width: 100%; height: 100%; isolation: isolate; container-type: inline-size; background: var(--cover-base); }
  .cover-gradient { position: absolute; z-index: 0; inset: 0; overflow: hidden; }
  /* one blurred ellipse per figma ellipse, each blurred on its own as figma draws them. */
  .cover-field { position: absolute; aspect-ratio: 1; border-radius: 50%; filter: blur(var(--field-blur)); }
  /* the slow drift runs only on screen (exhibits.ts sets is-live) and only when motion is welcome; otherwise the field is
     still. a motion cover's blobs carry their figma node id and follow its timeline instead. */
  @media (prefers-reduced-motion: no-preference) {
    .cover-field:not([data-node]) { animation: cover-field-drift var(--drift-s) ease-in-out infinite alternate; animation-play-state: paused; }
    .cover-gradient.is-live .cover-field { animation-play-state: running; }
  }
  /* behind an expanding macbook (CoverDevices) the field grows 1.06 times, 0.8s on the expo out curve going in and 0.7s on
     the ease in out curve coming back, as figma's demo timelines draw it. */
  @media (prefers-reduced-motion: no-preference) {
    .project-cover[data-devices="macbook"] .cover-gradient { transition: scale 0.7s cubic-bezier(0.65, 0, 0.35, 1); }
    :global(.project-card:is(:focus-visible, .is-expanding)) .project-cover[data-devices="macbook"] .cover-gradient { scale: 1.06; transition: scale 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.project-card:hover) .project-cover[data-devices="macbook"] .cover-gradient { scale: 1.06; transition: scale 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  }
  @keyframes cover-field-drift { to { translate: var(--drift-x) var(--drift-y); } }
</style>
