---
// Rachel Chen-inspired full-bleed motion cover, recolored from each project's real palette.
interface Props {
  project: {
    cardTitle: string;
    category: string;
    cardAlt: string;
    cover: {
      variant: string;
      video: string;
      poster: string;
      palette: string[];
      titlePlacement: string;
    };
  };
  priority?: boolean;
  size?: "card" | "hero";
}

const { project, priority = false, size = "card" } = Astro.props;
---

<div
  class:list={["project-cover", `cover-${project.cover.variant}`, `is-${size}`]}
  data-project-cover
  data-cover-variant={project.cover.variant}
  data-cover-palette={project.cover.palette.join(",")}
  style={`--cover-poster: url("${project.cover.poster}")`}
>
  <video
    class="cover-motion"
    autoplay
    muted
    loop
    playsinline
    preload={priority ? "auto" : "metadata"}
    poster={project.cover.poster}
    aria-hidden="true"
  >
    <source src={project.cover.video} type="video/mp4" />
  </video>
  <span class="cover-scrim" aria-hidden="true"></span>
  <div class="cover-label is-centered">
    <span>{project.cardTitle}</span>
  </div>
</div>

<style>
  .project-cover {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    isolation: isolate;
    background-color: #17344f;
    background-image: var(--cover-poster);
    background-position: center;
    background-size: cover;
  }

  .cover-motion {
    position: absolute;
    z-index: 1;
    inset: -2%;
    display: block;
    width: 104%;
    height: 104%;
    max-width: none;
    object-fit: cover;
  }

  .cover-scrim {
    position: absolute;
    z-index: 2;
    inset: 0;
    background: rgb(9 24 40 / 14%);
    pointer-events: none;
  }

  .cover-label {
    position: absolute;
    z-index: 3;
    inset: 0;
    display: grid;
    padding: clamp(24px, 4vw, 58px);
    place-items: center;
    color: #ffffff;
    text-align: center;
    text-shadow: 0 2px 22px rgb(4 17 31 / 28%);
  }

  .cover-label span {
    max-width: 82%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(26px, 3.1vw, 48px);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .is-card .cover-label span {
    font-size: clamp(24px, 2.4vw, 40px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-motion {
      display: none;
    }
  }
</style>
