---
// Site footer with copyright and the main contact links.
import { profile } from "@/data/profile";
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-paper-line dark:border-night-line">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-6 py-10 text-sm text-ink-muted dark:text-paper/60 sm:flex-row"
  >
    <span>&copy; {year} {profile.name}</span>
    <div class="flex gap-5">
      <a href={profile.links.github} class="transition-colors hover:text-accent">GitHub</a>
      <a href={profile.links.linkedin} class="transition-colors hover:text-accent">LinkedIn</a>
      <a href={`mailto:${profile.email}`} class="transition-colors hover:text-accent">Email</a>
    </div>
  </div>
</footer>