---
import { layerStyle } from "@/utils/coverMotion.mjs";

// a motion cover's layers over the field (figma 482:10252, 484:10700, 485:11148). each layer that moves carries its
// figma node id as data-node, which src/styles/cover-motion/<slug>.css animates. the component renders itself for each
// child layer, so every layer shares this style scope.
type Layer = { node?: string; box: number[]; style?: string; text?: string; src?: string; svg?: { w: number; h: number; body: string }; children?: Layer[] };

interface Props {
  slug: string;
  figma?: string;
  layers: Layer[];
  /** true for the cover's own wrapper; child layers render without it. */
  root?: boolean;
}
const { slug, figma, layers, root = false } = Astro.props;
---
{root ? (
  <div class="cover-motion" aria-hidden="true" data-cover-motion={slug} data-figma={figma}>
    <Astro.self slug={slug} layers={layers} />
  </div>
) : layers.map((layer) => (
  layer.src ? <img class="cm-layer" src={layer.src} alt="" loading="lazy" decoding="async" data-node={layer.node} style={layerStyle(layer)} />
  : layer.svg ? <svg class="cm-layer" width={layer.svg.w} height={layer.svg.h} viewBox={`0 0 ${layer.svg.w} ${layer.svg.h}`} fill="none" style={layerStyle(layer)} set:html={layer.svg.body} />
  : layer.text !== undefined ? <span class="cm-layer" data-node={layer.node} style={layerStyle(layer)}>{layer.text}</span>
  : <div class="cm-layer" data-node={layer.node} style={layerStyle(layer)}>{layer.children && <Astro.self slug={slug} layers={layer.children} />}</div>
))}
<style>
  /* figma sets some text in inter. the home page loads no specimen fonts (specimens.test.mjs), so that text falls back
     to the system face. */
  .cover-motion { position: absolute; z-index: 1; inset: 0; overflow: hidden; pointer-events: none; }
  /* figma places a layer by its top left corner; scale and rotate keyframes turn it about its centre, as figma does. */
  .cm-layer { position: absolute; box-sizing: border-box; max-width: none; line-height: normal; white-space: pre; }
  svg.cm-layer { overflow: visible; }
</style>
