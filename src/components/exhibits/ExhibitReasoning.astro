---
// make the path from evidence to decision visible (figma 689:18031): evidence, interpretation and proposed decision as
// three cards per row, orange arrows in the gutters between. a real table with explicit roles, like ExhibitTrace; on
// phones each row stacks and the arrows turn down.
interface Props {
  id: string;
  caption: string;
  columns: string[];
  rows: string[][];
}
const { id, caption, columns, rows } = Astro.props;
---
<table class="reasoning" role="table">
  <caption id={`${id}-caption`} class="sr-only">{caption}</caption>
  <thead role="rowgroup">
    <tr role="row">
      {columns.map((column, index) => <th scope="col" role="columnheader" class:list={[index === columns.length - 1 && "is-decision"]}>{column}</th>)}
    </tr>
  </thead>
  <tbody role="rowgroup">
    {rows.map((row) => (
      <tr role="row">
        {row.map((cell, index) => (
          <td role="cell" class:list={[index === row.length - 1 && "is-decision"]}>
            {index > 0 && <span class="reasoning-arrow" aria-hidden="true">→</span>}
            <span class="reasoning-card">{cell}</span>
          </td>
        ))}
      </tr>
    ))}
  </tbody>
</table>
<style>
  .reasoning { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .reasoning :is(th, td) { padding: 0 0 20px; text-align: left; vertical-align: top; }
  /* the second and third columns open on a gutter that holds the arrow. */
  .reasoning :is(th, td):not(:first-child) { position: relative; padding-left: 38px; }
  .reasoning th { padding-bottom: 32px; color: var(--accent); font: 400 12px / 1.4 var(--mono); letter-spacing: 0.06em; }
  .reasoning th.is-decision { color: var(--color-annotate); }
  .reasoning tbody tr:last-child td { padding-bottom: 0; }
  .reasoning-arrow { position: absolute; top: 36px; left: 9px; color: var(--color-annotate); font: 25px / 1 var(--ui-sans); }
  .reasoning-card { display: block; height: 100%; min-height: 126px; padding: 18px; border-radius: 4px; background: var(--surface); color: var(--ink); font: 18px / 1.4 var(--ui-sans); }
  .is-decision .reasoning-card { background: var(--accent-soft); color: var(--accent); }
  @media (max-width: 760px) {
    .reasoning, .reasoning :is(tbody, tr, td) { display: block; }
    .reasoning thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .reasoning tr { padding-bottom: 28px; }
    .reasoning tbody tr:last-child { padding-bottom: 0; }
    .reasoning td, .reasoning td:not(:first-child) { padding: 0; }
    .reasoning td:not(:first-child) { padding-top: 36px; }
    .reasoning-arrow { top: 6px; left: 18px; transform: rotate(90deg); font-size: 20px; }
    .reasoning-card { min-height: 0; font-size: 16px; }
  }
</style>
