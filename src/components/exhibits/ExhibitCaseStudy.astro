---
// the v2 case study layout (figma section 49:529) for any project that carries an exhibits array.
// copy comes from the project record unchanged; exhibit copy is the approved spec, verbatim.
import CaseStudyNav from "@/components/CaseStudyNav.astro";
import ExhibitStage from "@/components/exhibits/ExhibitStage.astro";
import ExhibitVisual from "@/components/exhibits/ExhibitVisual.astro";
import ExhibitJourney from "@/components/exhibits/ExhibitJourney.astro";
import ExhibitStrip from "@/components/exhibits/ExhibitStrip.astro";
import ExhibitMetrics from "@/components/exhibits/ExhibitMetrics.astro";
import NextProject from "@/components/exhibits/NextProject.astro";
import Notes from "@/components/exhibits/Notes.astro";
import SectionHead from "@/components/exhibits/SectionHead.astro";

interface Props {
  project: any;
  next: any;
}
const { project, next } = Astro.props;
const exhibits: any[] = project.exhibits;
const hero = exhibits.find((exhibit) => exhibit.kind === "hero");
const chapters = exhibits.map((exhibit) => ({ id: exhibit.id, label: exhibit.chapter }));
const palette: string[] = project.cover.palette;

/** width over height of a stage, from its css ratio string such as "1116 / 680". */
function stageRatio(exhibit: any): number {
  const ratio = exhibit.ratio ?? (exhibit.kind === "hero" ? "1116 / 600" : "1116 / 680");
  const [width, height] = ratio.split("/").map(Number);
  return width / height;
}

/** the narrative section an exhibit chapter points at, rendered with its text unchanged. */
function sectionFor(exhibit: any) {
  return project.sections.find((section: any) => section.id === exhibit.section);
}
---
<div class="exhibit-shell">
  <CaseStudyNav chapters={chapters} variant="exhibit" />

  <article class="exhibit-case">
    <section id={hero.id} class="exhibit-chapter is-overview" data-case-section aria-labelledby="case-title">
      <header class="exhibit-header">
        <p class="exhibit-eyebrow">{project.organization} · {project.category} · {project.year}</p>
        <h1 id="case-title" style={`view-transition-name: title-${project.slug}`}>{project.title}</h1>
        <p class="exhibit-summary">{project.summary}</p>
      </header>

      <div class="hero-wrap" style={`view-transition-name: cover-${project.slug}`} data-project-cover>
        <ExhibitStage palette={palette} size="hero">
          {hero.visuals.map((visual: any, index: number) => (
            <ExhibitVisual visual={visual} stageRatio={stageRatio(hero)} priority={index === hero.visuals.length - 1} />
          ))}
        </ExhibitStage>
        {hero.kpi && (
          <div class="hero-kpi" style={hero.kpi.at && `left: ${hero.kpi.at.x}%; top: ${hero.kpi.at.y}%`}>
            <p class="kpi-eyebrow">{hero.kpi.eyebrow}</p>
            <p class="kpi-value">{hero.kpi.value}</p>
            <p class="kpi-label">{hero.kpi.label}</p>
          </div>
        )}
      </div>

      <dl class="case-meta">
        <div><dt>Role</dt><dd>{project.role}</dd></div>
        <div><dt>Timeline</dt><dd>{project.timeline}</dd></div>
        <div><dt>Team</dt><dd>{project.team}</dd></div>
        <div><dt>Skills</dt><dd>{project.skills.join(", ")}</dd></div>
      </dl>

      {project.links?.length > 0 && (
        <nav class="exhibit-links" aria-label="Project sources">
          {project.links.map((link: any) => <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>)}
        </nav>
      )}

      <ExhibitMetrics metrics={hero.metrics} />
    </section>

    {exhibits.filter((exhibit) => exhibit.kind !== "hero").map((exhibit) => {
      if (exhibit.kind === "section") {
        const section = sectionFor(exhibit);
        // a closing chapter can open on a strip (usm's decision framework, 68:1126), anchored where the strip
        // sits in figma, with the section's own prose under it.
        return (
          <section id={exhibit.id} class:list={["exhibit-chapter", exhibit.strip && "opens-on-strip"]} data-case-section aria-labelledby={`${exhibit.id}-heading`}>
            {exhibit.strip && <ExhibitStrip strip={exhibit.strip} />}
            <div class:list={[exhibit.strip && "closing-prose"]}>
              <SectionHead id={`${exhibit.id}-heading`} eyebrow={section.label} heading={section.heading} />
              <div class="exhibit-prose">{section.body.map((paragraph: string) => <p>{paragraph}</p>)}</div>
            </div>
          </section>
        );
      }
      return (
        <section id={exhibit.id} class="exhibit-chapter" data-case-section aria-labelledby={`${exhibit.id}-heading`}>
          <SectionHead id={`${exhibit.id}-heading`} eyebrow={exhibit.eyebrow} heading={exhibit.heading} />
          <div class="exhibit-body">
            {exhibit.kind === "stage" && (
              <>
                <ExhibitStage palette={palette} size={exhibit.size} ratio={exhibit.ratio}>
                  {exhibit.visuals.map((visual: any) => <ExhibitVisual visual={visual} stageRatio={stageRatio(exhibit)} />)}
                  {[...(exhibit.annotations ?? [])].sort((a: any, b: any) => Number(a.num) - Number(b.num)).map((annotation: any) => (
                    <ExhibitVisual visual={exhibit.visuals[annotation.on]} stageRatio={stageRatio(exhibit)} idPrefix={exhibit.id} annotations={[annotation]} overlay />
                  ))}
                </ExhibitStage>
                {exhibit.notes && <Notes notes={exhibit.notes} idPrefix={exhibit.id} />}
              </>
            )}
            {exhibit.kind === "journey" && (
              <ExhibitJourney id={exhibit.id} stages={exhibit.stages} accentStage={exhibit.accentStage} rows={exhibit.rows} strip={exhibit.strip} caption={exhibit.heading} />
            )}
          </div>
        </section>
      );
    })}

    <NextProject next={next} />
  </article>
</div>

<style>
  .exhibit-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1116px);
    gap: 56px;
    padding: 48px 24px 0;
  }
  .exhibit-case { min-width: 0; padding-bottom: 40px; }
  .exhibit-chapter { scroll-margin-top: 32px; }
  .exhibit-chapter + .exhibit-chapter { margin-top: 96px; }
  /* figma keeps the strip 32px under the journey map it follows, even though it starts a new chapter. */
  .exhibit-chapter + .exhibit-chapter.opens-on-strip { margin-top: 32px; }
  .closing-prose { margin-top: 72px; }
  .exhibit-eyebrow { margin: 0; color: var(--muted); font: 11px / 1.4 var(--mono); letter-spacing: 0.04em; text-transform: uppercase; }
  .exhibit-header h1 { margin: 16px 0 0; color: var(--ink-strong); font: 400 clamp(46px, 5.6vw, 72px) / 1 var(--display); letter-spacing: -0.03em; }
  .exhibit-summary { max-width: 820px; margin: 16px 0 0; color: var(--ink); font: 19px / 1.55 var(--body); }
  /* the kpi floats over the stage on wide screens and drops below it on narrow ones. */
  .hero-wrap { position: relative; margin-top: 40px; }
  .hero-kpi {
    position: absolute;
    z-index: 4;
    top: 73.3%;
    left: 71.7%;
    display: grid;
    gap: 6px;
    padding: 16px 18px;
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 24px 48px rgb(3 13 26 / 45%);
  }
  .hero-kpi p { margin: 0; white-space: nowrap; }
  .kpi-eyebrow { color: #52697e; font: 10px / 1.3 var(--mono); letter-spacing: 0.08em; }
  .kpi-value { color: #071b2d; font: 400 34px / 1.2 var(--display); }
  .kpi-label { color: #52697e; font: 500 13px / 1.3 var(--ui); }
  .case-meta { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; margin: 40px 0 0; padding: 21px 0 0; border-top: 1px solid var(--rule); }
  .case-meta dt { color: var(--muted); font: 11px / 1.4 var(--mono); letter-spacing: 0.04em; text-transform: uppercase; }
  .case-meta dd { margin: 6px 0 0; color: var(--ink); font: 17px / 1.5 var(--body); }
  .exhibit-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .exhibit-links a { padding: 10px 12px; border: 1px solid var(--rule); color: var(--accent); font: 10px / 1.3 var(--mono); letter-spacing: 0.02em; text-transform: uppercase; }
  .exhibit-links a:hover, .exhibit-links a:focus-visible { border-color: var(--accent); background: var(--accent); color: var(--on-accent); }
  .exhibit-body { margin-top: 32px; }
  .exhibit-prose { max-width: 66ch; margin-top: 28px; }
  .exhibit-prose p { margin: 0; color: var(--ink); font: 18px / 1.62 var(--body); }
  .exhibit-prose p + p { margin-top: 18px; }

  @media (max-width: 980px) {
    .exhibit-shell { display: block; padding: 34px var(--page-gutter) 0; }
  }
  @media (max-width: 760px) {
    .hero-kpi { position: static; margin-top: 12px; box-shadow: 0 1px 3px rgb(3 13 26 / 12%); border: 1px solid var(--rule); }
    .case-meta { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 18px; }
    .exhibit-chapter + .exhibit-chapter { margin-top: 72px; }
  }
</style>
