---
// the elms paper prototypes (figma 426:777): a small head, then four photos in two columns, each on figma's paper
// tone and captioned with its number, the problem it answers and the heuristic behind it. a photo opens full size,
// and a card lifts 4px on hover when motion is welcome.
import { exhibitSrcset } from "@/utils/exhibitSrcset";

interface Props {
  papers: {
    label: string;
    title: string;
    body: string;
    cards: { num: string; title: string; body: string; photo: { src: string; width: number; height: number; alt: string } }[];
  };
}
const { papers } = Astro.props;
// a photo is half the column, less the 40 gap, and the whole column once the grid stacks.
const sizes = "(max-width: 760px) calc(100vw - 40px), calc((min(1116px, 100vw - 48px) - 40px) / 2)";
---
<div class="papers">
  <div class="papers-head">
    <p class="papers-label">{papers.label}</p>
    <p class="papers-title">{papers.title}</p>
    <p class="papers-body">{papers.body}</p>
  </div>
  <ul class="papers-grid">
    {papers.cards.map((card) => (
      <li class="paper">
        <a class="paper-photo" href={card.photo.src}>
          <picture>
            <source type="image/webp" srcset={exhibitSrcset(card.photo.src)} sizes={sizes} />
            <img src={card.photo.src} alt={card.photo.alt} width={card.photo.width} height={card.photo.height} loading="lazy" decoding="async" />
          </picture>
        </a>
        <div class="paper-caption">
          <p class="paper-num">{card.num}</p>
          <p class="paper-title">{card.title}</p>
          <p class="paper-body">{card.body}</p>
        </div>
      </li>
    ))}
  </ul>
</div>
<style>
  .papers { display: grid; gap: 24px; margin-top: 24px; }
  .papers p { margin: 0; }
  .papers-head { display: grid; gap: 8px; max-width: 680px; }
  .papers-label { color: var(--muted); font: 12px / 1.3 var(--mono); letter-spacing: -0.02em; }
  .papers-title { color: var(--ink-strong); font: 400 24px / 30px var(--display); letter-spacing: -0.01em; }
  .papers-body { color: var(--ink); font: 16px / 24px var(--body); }
  .papers-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; margin: 0; padding: 0; list-style: none; }
  .paper { display: grid; align-content: start; gap: 16px; }
  /* figma's 538 by 330 photo box: the sketch whole on the paper tone, a 12 radius and a hairline. */
  .paper-photo { position: relative; display: block; aspect-ratio: 538 / 330; overflow: hidden; border: 1px solid var(--rule); border-radius: 12px; background: #f3f0e8; }
  .paper-photo picture { display: contents; }
  .paper-photo img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; }
  .paper-photo:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .paper-caption { display: grid; gap: 6px; max-width: 500px; }
  .paper-num { color: var(--muted); font: var(--label-micro, 10px) / 14px var(--mono); letter-spacing: 0.06em; }
  .paper-title { color: var(--ink-strong); font: 600 14px / 1.3 var(--ui-sans); letter-spacing: -0.005em; }
  .paper-body { color: var(--secondary); font: 16px / 24px var(--body); }
  @media (prefers-reduced-motion: no-preference) {
    .paper-photo { transition: translate 200ms var(--ease-out), box-shadow 200ms var(--ease-out); }
    .paper-photo:is(:hover, :focus-visible) { translate: 0 -4px; box-shadow: 0 12px 24px rgb(13 20 31 / 12%); }
  }
  @media (max-width: 760px) {
    .papers-grid { grid-template-columns: minmax(0, 1fr); gap: 32px; }
  }
</style>
