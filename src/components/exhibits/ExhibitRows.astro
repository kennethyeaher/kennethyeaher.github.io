---
// rows per figma 55:681: a 600 square stage beside its caption, one screen per row. the device runs off
// the stage's right and bottom edges, as in figma, and the media tag sits in the stage's corner. reversed rows
// (frontground 222:440) put the caption first and run the full 1116, so the stage meets the right edge.
import Caption from "@/components/exhibits/Caption.astro";
import ExhibitStage from "@/components/exhibits/ExhibitStage.astro";
import ExhibitVisual from "@/components/exhibits/ExhibitVisual.astro";
import MediaTag from "@/components/exhibits/MediaTag.astro";

interface Props {
  palette: string[];
  visuals: any[];
  captions: { tag?: string; title: string; body: string }[];
  fields?: any[];
  base?: string;
  /** a base colour per row, where figma gives each row stage its own (terpcarehub 90:1689, 90:1699, 90:1709). */
  bases?: string[];
  veil?: boolean;
  reverse?: boolean;
  /** an eyebrow, title and body above the rows in place of a side caption (terpcare dark mode). */
  lead?: { eyebrow: string; title: string; body: string };
}
const { palette, visuals, captions, fields = [], base, bases = [], veil = false, reverse = false, lead } = Astro.props;
---
{lead && (
  <div class="rows-lead">
    <p class="rows-lead-eyebrow">{lead.eyebrow}</p>
    <Caption title={lead.title} body={lead.body} />
  </div>
)}
<div class:list={["exhibit-rows", reverse && "is-reverse", lead && "has-lead"]}>
  {visuals.map((visual, index) => (
    <div class="exhibit-row">
      {reverse && captions[index] && (
        <div class="row-caption">
          <Caption title={captions[index].title} body={captions[index].body} />
        </div>
      )}
      <ExhibitStage palette={palette} size="square" field={fields[index]} base={bases[index] ?? base} veil={veil}>
        <ExhibitVisual visual={visual} stageRatio={1} stageWidth={600 / 1116} />
        {/* the media tag marks a stage that ships as a looping video (figma 50:584), so a still row shows none.
            it carries the loop's pause control in the stage's corner (132:1838), clear of the device. */}
        {captions[index]?.tag && visual.loop && <span class="row-tag"><MediaTag text={captions[index].tag!} loop={visual.loop.name ?? ""} /></span>}
      </ExhibitStage>
      {!reverse && captions[index] && (
        <div class="row-caption">
          <Caption title={captions[index].title} body={captions[index].body} />
        </div>
      )}
    </div>
  ))}
</div>
<style>
  /* figma puts the first row 56px under the head; the exhibit body already adds 32. */
  .exhibit-rows { display: grid; gap: 56px; margin-top: 24px; }
  .exhibit-row { display: grid; grid-template-columns: minmax(0, 600px) minmax(0, 400px); align-items: end; gap: 56px; }
  /* a lead sits 80px under the loop card and 32px over the stage, as wide as a caption may run, flush with the stage. */
  .rows-lead { display: grid; gap: 10px; max-width: 560px; margin-top: 80px; }
  .rows-lead-eyebrow { margin: 0; color: var(--muted); font: 11px / 14px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .rows-lead :global(.exhibit-caption) { max-width: 560px; }
  .exhibit-rows.has-lead { margin-top: 32px; }
  .row-tag { position: absolute; z-index: 4; top: 3%; left: 3%; }
  .row-caption :global(.exhibit-caption) { max-width: 400px; }
  /* below a 560 wide stage the pill reaches the phone's top edge, so the phone drops 20px and stays clear of it. */
  @container (max-width: 560px) {
    .exhibit-row :global(.exhibit-visual.is-placed:has(.frame-iphone)) { margin-top: 20px; }
  }
  @media (min-width: 761px) {
    .is-reverse .exhibit-row { grid-template-columns: minmax(0, 400px) minmax(0, 600px); justify-content: space-between; }
  }
  @media (max-width: 760px) {
    .exhibit-row { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  }
</style>
