---
// a live specimen per figma 363:517 ("Additions / Specimens v2"): a section head one level under the chapter's, a
// full width stage that holds the specimen, with its controls in the top right corner and the LIVE tag in the bottom
// left, and its three notes in a row under it. the specimen itself goes in the default slot
// (src/components/exhibits/specimens) and lays itself out across the whole stage.
import Notes from "@/components/exhibits/Notes.astro";
import SectionHead from "@/components/exhibits/SectionHead.astro";

interface Props {
  id: string;
  kind: string;
  eyebrow: string;
  heading: string;
  /** "LIVE · TAP TO BOOK" and the like. */
  tag: string;
  notes: { n: string; title: string; body: string }[];
  /** the stage's background from the mock: a colour, or gradients for its glows. */
  background: string;
  /** a dark stage takes a white focus ring, a light one the accent. a specimen can override --specimen-focus inside. */
  tone: "light" | "dark";
  /** the stage's width to height in the mock, a floor: a stage grows to fit what it holds. */
  ratio?: string;
}
const { id, kind, eyebrow, heading, tag, notes, background, tone, ratio = "1116 / 640" } = Astro.props;
---
<figure class="specimen" id={id} data-specimen={kind} aria-labelledby={`${id}-heading`}>
  <SectionHead id={`${id}-heading`} eyebrow={eyebrow} heading={heading} level={3} />
  <div class:list={["specimen-stage", `is-${tone}`]} style={`--specimen-stage: ${background}; --specimen-ratio: ${ratio}`}>
    {Astro.slots.has("controls") && <div class="specimen-controls"><slot name="controls" /></div>}
    <div class="specimen-body"><slot /></div>
    <p class="specimen-tag">{tag}</p>
  </div>
  <Notes notes={notes} idPrefix={id} />
</figure>
<style>
  .specimen { margin: 0; }
  /* the mock's notes: 249 wide columns 40 apart, filling from the left, 32 under the stage. */
  .specimen :global(.exhibit-notes) { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin-top: 32px; }
  /* the mock's stage is 1116 by 640, 32 under the head. it is the specimens' container: --u is a specimen pixel, 1px
     on the full stage and shrinking with it (container units) to 0.75px, so a desktop layout keeps its proportions
     on a narrower column; each specimen reflows to its stacked phone layout below 760 wide
     (@container specimen (max-width: 759px)), where it sets --u back to 1px. */
  .specimen-stage {
    --specimen-focus: #1f4f7a;
    --u: clamp(0.75px, 0.0896cqw, 1px);
    position: relative;
    display: grid;
    aspect-ratio: var(--specimen-ratio, 1116 / 640);
    margin-top: 32px;
    overflow: clip;
    border-radius: 6px;
    background: var(--specimen-stage);
    container: specimen / inline-size;
  }
  .specimen-stage.is-dark { --specimen-focus: #ffffff; }
  .specimen-body { display: grid; min-width: 0; }
  .specimen-controls { position: absolute; z-index: 2; top: 20px; right: 20px; }
  .specimen-tag {
    position: absolute;
    z-index: 2;
    bottom: 20px;
    left: 20px;
    margin: 0;
    padding: 5px 10px 6px 11px;
    border: 1px solid #dee5e8;
    border-radius: 999px;
    background: #ffffff;
    color: #273440;
    /* the micro label size: 10px, and 11px on phones (global.css). */
    font: var(--label-micro, 10px) / 13px var(--mono);
    white-space: nowrap;
  }
  /* the mock's Light and Dark pill (367:521): the pressed half is filled. at least 32px tall at any stage size. */
  .specimen :global(.specimen-switch) { --specimen-focus: #ffffff; display: flex; gap: 2px; padding: 3px; border-radius: 999px; background: rgb(255 255 255 / 14%); }
  .specimen :global(.specimen-switch button) { min-height: 32px; padding: 6px 14px; border: 0; border-radius: 999px; background: transparent; color: rgb(255 255 255 / 85%); font: 500 12px / 15px "Inter", var(--ui); cursor: pointer; }
  .specimen :global(.specimen-switch [aria-pressed="true"]) { background: #ffffff; color: #16161a; font-weight: 600; }
  /* one ring for every control, in the colour the surface under it sets. */
  .specimen :global(:is(button, input, textarea):focus-visible) { outline: 2px solid var(--specimen-focus); outline-offset: 2px; }
  .specimen :global(.visually-hidden) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 760px) {
    .specimen-tag { bottom: 16px; left: 16px; }
    .specimen-controls { top: 16px; right: 16px; }
  }
</style>
