---
// next project link per figma 61:1059. hovering or focusing it previews the target cover.
interface Props {
  next: { slug: string; cardTitle: string; cover: { poster: string } };
}
const { next } = Astro.props;
---
<nav class="next-project" aria-label="More case studies" data-project-pager>
  <a class="next-link" href={`/work/${next.slug}`}>
    <span class="next-eyebrow">Next project</span>
    <span class="next-title">{next.cardTitle} <span aria-hidden="true">→</span></span>
    <img class="next-preview" src={next.cover.poster} alt="" width="240" height="135" loading="lazy" decoding="async" />
  </a>
</nav>
<style>
  .next-project { margin-top: 40px; padding-top: 40px; border-top: 1px solid var(--rule); }
  .next-link { display: grid; grid-template-columns: 1fr 240px; grid-template-rows: auto auto; align-items: center; gap: 8px 32px; color: var(--ink-strong); }
  .next-eyebrow { color: var(--muted); font: 12px / 1.3 var(--mono); text-transform: uppercase; }
  .next-title { grid-row: 2; font: 400 clamp(36px, 4.5vw, 48px) / 1.1 var(--display); letter-spacing: -0.02em; transition: color 180ms ease; }
  .next-preview { grid-row: 1 / 3; grid-column: 2; width: 240px; height: 135px; object-fit: cover; opacity: 0; translate: 12px 0; transition: opacity 300ms var(--ease-out), translate 300ms var(--ease-out); }
  .next-link:hover .next-title, .next-link:focus-visible .next-title { color: var(--accent); }
  .next-link:hover .next-preview, .next-link:focus-visible .next-preview { opacity: 1; translate: 0 0; }
  /* without hover there is nothing to reveal it, so the preview simply shows. */
  @media (hover: none) { .next-preview { opacity: 1; translate: 0 0; } }
  @media (prefers-reduced-motion: reduce) { .next-preview { transition: none; translate: 0 0; } }
  @media (max-width: 620px) {
    .next-link { grid-template-columns: 1fr; }
    .next-preview { grid-row: 3; grid-column: 1; width: 100%; height: auto; aspect-ratio: 16 / 9; opacity: 1; translate: 0 0; }
  }
</style>
