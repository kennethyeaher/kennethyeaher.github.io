---
// a muted looping clip that only plays while in view, with a poster. its pause control sits in the stage's
// media tag (figma 132:1838), never on the device, and finds this clip by the video's id.
// under reduced motion, or without scripts, the poster stays as the still.
import { loopId } from "@/utils/loop.mjs";

interface Props {
  src: string;
  poster: string;
  width: number;
  height: number;
  label: string;
  /** what tells this loop apart from others on the page, from its caption: "state" gives "Pause state loop". */
  name?: string;
}
const { src, poster, width, height, label, name } = Astro.props;
const loopName = name ? `${name} loop` : "loop";
---
<div class="exhibit-loop" data-exhibit-loop data-loop-name={loopName}>
  <video id={loopId(loopName)} muted loop playsinline preload="none" poster={poster} width={width} height={height} aria-label={label}>
    <source data-src={src} type="video/mp4" />
  </video>
</div>
<style>
  .exhibit-loop { position: relative; }
  .exhibit-loop video { display: block; width: 100%; height: auto; }
</style>
