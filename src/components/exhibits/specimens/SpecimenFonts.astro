---
// the @font-face rules for a page's live specimens, written inline into that page's head only. the case studies share
// one route and so one stylesheet, which is why these are not in a component <style>.
import { specimenFaces } from "./fonts.mjs";

interface Props {
  fonts: string[];
}
const { fonts } = Astro.props;
// the latin range google fonts serves for these families.
const latin = "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD";
const css = fonts
  .map((name) => specimenFaces[name as keyof typeof specimenFaces])
  .map((face) => `@font-face { font-family: "${face.family}"; font-style: normal; font-weight: ${face.weight}; font-display: swap; src: url("${face.src}") format("woff2"); unicode-range: ${latin}; }`)
  .join("\n");
---
{css && <style is:inline set:html={css} />}
