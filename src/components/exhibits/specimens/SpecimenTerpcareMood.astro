---
// terpcare, five levels (figma 367:521): the mood check in drawn twice, light and dark, from one set of tokens. all
// five levels are a word, a bar count and their own colour; the tags say what is affecting it; the week strip below
// fills in as levels are saved and leaves a missed day blank. one half is live at a time and the other mirrors it,
// hidden from screen readers and out of the tab order; the Light and Dark switch says which. on a phone only the
// live half shows. the state is terpcare-mood.mjs.
import ExhibitSpecimen from "@/components/exhibits/ExhibitSpecimen.astro";
import { createMood, dateLabel, dayInitial, dayLabel, levelOf, levels, tags } from "./terpcare-mood.mjs";

interface Props {
  specimen: { kind: string; eyebrow: string; heading: string; tag: string; notes: { n: string; title: string; body: string }[] };
}
const { specimen } = Astro.props;
const id = `specimen-${specimen.kind}`;
const state = createMood();
const halves = [{ theme: "light", label: "LIGHT", live: true }, { theme: "dark", label: "DARK", live: false }];
const barHeights = [7, 10, 13, 16, 19];
const tileHeights = [4, 6, 8, 10, 12];
---
<ExhibitSpecimen id={id} kind={specimen.kind} eyebrow={specimen.eyebrow} heading={specimen.heading} tag={specimen.tag} notes={specimen.notes} background="#f4f4f6" tone="light" ratio="1116 / 680">
  <div slot="controls" class="specimen-switch" role="group" aria-label="Specimen theme">
    <button type="button" aria-pressed="true" data-mood-switch="light">Light</button>
    <button type="button" aria-pressed="false" data-mood-switch="dark">Dark</button>
  </div>
  <div class="mood" data-mood data-live="light">
    {halves.map((half) => {
      const tab = (on: boolean) => (half.live ? (on ? "0" : "-1") : "-1");
      return (
        <div class="mood-half" data-mood-half={half.theme} aria-hidden={half.live ? undefined : "true"} data-mood-theme={half.theme}>
          <p class="mood-half-label">{half.label}</p>
          <div class="mood-sheet">
            <p class="mood-ask">How are you today?</p>
            <p class="mood-date" data-mood-date>{dateLabel(state.day)}</p>
            <div class="mood-levels" role="radiogroup" aria-label="Mood">
              {levels.map((level) => {
                const on = state.week[state.day] === level.key;
                return (
                  <button type="button" role="radio" class="mood-level" aria-checked={on ? "true" : "false"} tabindex={tab(on)} data-level={level.key} style={`--tone: var(--mood-${level.bars}); --tone-bg: var(--mood-${level.bars}-bg)`}>
                    <span class="mood-bars" aria-hidden="true">
                      {barHeights.map((height, bar) => <span class:list={["mood-bar", bar < level.bars && "is-on"]} style={`height: calc(${height} * var(--u))`}></span>)}
                    </span>
                    <span class="mood-word">{level.label}</span>
                    <span class="mood-selected" aria-hidden="true">Selected</span>
                  </button>
                );
              })}
            </div>
            <p class="mood-affecting" aria-hidden="true">What is affecting it?</p>
            <div class="mood-tags" role="group" aria-label="What is affecting it">
              {tags.map((tag) => <button type="button" class="mood-tag" aria-pressed={state.tags[state.day].includes(tag) ? "true" : "false"} tabindex={half.live ? undefined : "-1"} data-tag={tag}>{tag}</button>)}
            </div>
          </div>
          <div class="mood-week">
            <p class="mood-week-label" aria-hidden="true">THIS WEEK · NO STREAKS</p>
            <div class="mood-days" role="radiogroup" aria-label="This week">
              {state.week.map((key, index) => {
                const level = levelOf(key);
                const on = index === state.day;
                return (
                  <button type="button" role="radio" class="mood-day" aria-checked={on ? "true" : "false"} tabindex={tab(on)} aria-label={dayLabel(state, index)} data-day={index}
                    style={level ? `--tone: var(--mood-${level.bars}); --tone-bg: var(--mood-${level.bars}-bg)` : undefined}>
                    <span class="mood-day-initial" aria-hidden="true">{dayInitial(index)}</span>
                    <span class="mood-bars is-small" aria-hidden="true">
                      {tileHeights.map((height, bar) => <span class:list={["mood-bar", level && bar < level.bars && "is-on"]} style={`height: calc(${height} * var(--u))`}></span>)}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>
        </div>
      );
    })}
  </div>
</ExhibitSpecimen>

<style>
  /* the tokens: the five mood pairs and the surfaces, light first, then dark on the same names. the light pairs
     and dark bars are the brief's; the dark fills are the TerpCare foundations variables (d0f9C7rHMVCYMWwsPBlgUn,
     color/mood/1-bg to 5-bg). the surfaces are the mock's. */
  .mood-half {
    --mood-5: #0b6e4f; --mood-5-bg: #ddf3ea;
    --mood-4: #1a64a3; --mood-4-bg: #e1eefa;
    --mood-3: #5c5c66; --mood-3-bg: #eeeef0;
    --mood-2: #8a5a00; --mood-2-bg: #fff0d6;
    --mood-1: #6b3fb8; --mood-1-bg: #efe7fb;
    --half: #f4f4f6; --surface: #ffffff; --border: #e3e3e6; --text: #16161a; --secondary: #5c5c66;
    --chosen: #16161a; --on-chosen: #ffffff; --specimen-focus: #1f4f7a;
  }
  .mood-half[data-mood-theme="dark"] {
    --mood-5: #5ac896; --mood-5-bg: #123428;
    --mood-4: #6eaaf0; --mood-4-bg: #142840;
    --mood-3: #aaaab2; --mood-3-bg: #28282c;
    --mood-2: #e6aa46; --mood-2-bg: #3c2c0e;
    --mood-1: #b496f0; --mood-1-bg: #2c2042;
    --half: #0b0b0d; --surface: #16161a; --border: #2c2c31; --text: #f4f4f6; --secondary: #aaaab2;
    --chosen: #f4f4f6; --on-chosen: #16161a; --specimen-focus: #ffffff;
  }

  /* the mock's switch is white at 14% over the dark half; solid here, so it still shows over the light half on a
     phone, and the white ring around a focused half falls on its own dark pill. */
  :global(figure[data-specimen="terpcare-mood"]) .specimen-switch { background: #2a2a2d; }

  /* two 558 wide halves of the 1116 by 680 stage: the label 36 down, the 478 wide sheet 64 down, the week under it.
     sized in specimen pixels (--u, ExhibitSpecimen.astro). */
  .mood { display: grid; grid-template-columns: 1fr 1fr; font-family: "Inter", var(--ui); }
  .mood-half { display: grid; align-content: start; gap: calc(20 * var(--u)); padding: calc(36 * var(--u)) calc(40 * var(--u)) calc(76 * var(--u)); background: var(--half); color: var(--text); }
  .mood-half-label { margin-bottom: calc(-5 * var(--u)); color: var(--secondary); font: var(--label-micro, 10px) / 13px var(--mono); letter-spacing: 0.04em; }
  .mood-sheet { display: grid; align-content: start; min-height: calc(440 * var(--u)); padding: calc(22 * var(--u)) calc(24 * var(--u)) calc(28 * var(--u)); border: 1px solid var(--border); border-radius: calc(22 * var(--u)); background: var(--surface); }
  .mood-ask { font-weight: 700; font-size: max(18px, calc(20 * var(--u))); line-height: 1.2; }
  .mood-date { margin-top: 4px; color: var(--secondary); font-weight: 400; font-size: 13px; line-height: 16px; }
  .mood-levels { display: grid; gap: calc(8 * var(--u)); margin-top: calc(14 * var(--u)); }
  .mood-level { display: flex; align-items: center; gap: calc(14 * var(--u)); min-height: max(40px, calc(42 * var(--u))); padding: 0 calc(14 * var(--u)) 0 calc(15 * var(--u)); border: 1px solid var(--border); border-radius: calc(12 * var(--u)); background: var(--surface); color: var(--text); font: 500 15px / 18px "Inter", var(--ui); text-align: left; cursor: pointer; }
  /* the chosen level fills with its own pair and takes a 2px edge in its colour, drawn inside so nothing shifts. */
  .mood-level[aria-checked="true"] { border-color: var(--tone); background: var(--tone-bg); box-shadow: inset 0 0 0 1px var(--tone); font-weight: 600; }
  .mood-bars { display: flex; flex: none; align-items: flex-end; gap: calc(2 * var(--u)); height: calc(19 * var(--u)); }
  .mood-bar { width: calc(4 * var(--u)); border-radius: 1px; background: var(--border); }
  .mood-bar.is-on { background: var(--tone); }
  .mood-word { flex: 1; }
  .mood-selected { color: var(--secondary); font-weight: 400; font-size: 12px; visibility: hidden; }
  .mood-level[aria-checked="true"] .mood-selected { visibility: visible; }
  .mood-affecting { margin-top: calc(16 * var(--u)); color: var(--secondary); font-size: 12px; line-height: 15px; }
  .mood-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .mood-tag { min-height: 32px; padding: 0 14px; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); color: var(--text); font: 500 13px / 16px "Inter", var(--ui); cursor: pointer; }
  .mood-tag[aria-pressed="true"] { border-color: var(--chosen); background: var(--chosen); color: var(--on-chosen); }

  .mood-week { padding: calc(14 * var(--u)) calc(20 * var(--u)) calc(12 * var(--u)); border: 1px solid var(--border); border-radius: calc(18 * var(--u)); background: var(--surface); }
  .mood-week-label { color: var(--secondary); font: var(--label-micro, 10px) / 13px var(--mono); letter-spacing: 0.04em; white-space: pre; }
  .mood-days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: calc(10 * var(--u)); margin-top: calc(7 * var(--u)); }
  .mood-day { display: flex; align-items: center; justify-content: space-between; min-height: max(34px, calc(34 * var(--u))); padding: 0 calc(8 * var(--u)); border: 1px solid var(--border); border-radius: calc(10 * var(--u)); background: var(--tone-bg, transparent); cursor: pointer; }
  .mood-day[aria-checked="true"] { border-color: var(--tone, var(--secondary)); box-shadow: inset 0 0 0 1px var(--tone, var(--secondary)); }
  .mood-day-initial { color: var(--secondary); font: 500 11px / 13px "Inter", var(--ui); }
  .mood-bars.is-small { gap: calc(1 * var(--u)); height: calc(12 * var(--u)); }
  .mood-bars.is-small .mood-bar { width: calc(3 * var(--u)); }

  @media (prefers-reduced-motion: no-preference) {
    /* a choice lands on the cord's spring, about 400ms; colours ease in 200ms. */
    .mood-level, .mood-day, .mood-tag, .mood-bar { transition: background-color 200ms var(--ease-out), border-color 200ms var(--ease-out), box-shadow 200ms var(--ease-out), color 200ms var(--ease-out); }
    .mood[data-touched] [aria-checked="true"]:is(.mood-level, .mood-day) { animation: mood-land 400ms var(--cord-spring); }
    @keyframes mood-land { from { scale: 0.97; } }
  }

  /* on a phone the live half fills the stage alone. */
  @container specimen (max-width: 759px) {
    .mood { --u: 1px; grid-template-columns: minmax(0, 1fr); }
    .mood-half { padding: 64px 16px 64px; }
    .mood-sheet { min-height: 0; padding: 20px 16px 20px; }
    .mood-week { padding: 12px 12px 10px; }
    .mood-days { gap: 4px; }
    .mood-day { justify-content: center; flex-direction: column; gap: 3px; min-height: 48px; padding: 4px 0; }
    .mood[data-live="light"] [data-mood-half="dark"], .mood[data-live="dark"] [data-mood-half="light"] { display: none; }
  }
</style>

<script>
  import * as mood from "./terpcare-mood.mjs";

  // both halves draw the same state; only the live one is in the tab order and the accessibility tree. the mood
  // and the week are radiogroups (one tab stop, arrows move and choose); the tags are toggles.
  document.querySelectorAll<HTMLElement>('figure[data-specimen="terpcare-mood"]').forEach((figure) => {
    const root = figure.querySelector<HTMLElement>("[data-mood]")!;
    const halves = [...root.querySelectorAll<HTMLElement>("[data-mood-half]")];
    const switches = [...figure.querySelectorAll<HTMLButtonElement>("[data-mood-switch]")];
    let state = mood.createMood();
    let live = "light";

    const tone = (key: string | null) => {
      const level = mood.levelOf(key);
      return level ? `--tone: var(--mood-${level.bars}); --tone-bg: var(--mood-${level.bars}-bg)` : "";
    };

    function draw(): void {
      for (const half of halves) {
        const isLive = half.dataset.moodHalf === live;
        if (isLive) half.removeAttribute("aria-hidden");
        else half.setAttribute("aria-hidden", "true");
        half.querySelector<HTMLElement>("[data-mood-date]")!.textContent = mood.dateLabel(state.day);
        half.querySelectorAll<HTMLButtonElement>("[data-level]").forEach((radio) => {
          const on = state.week[state.day] === radio.dataset.level;
          radio.setAttribute("aria-checked", String(on));
          radio.tabIndex = isLive && on ? 0 : -1;
        });
        // with no level saved for the day, the group's first radio holds the tab stop.
        if (isLive && !state.week[state.day]) half.querySelector<HTMLButtonElement>("[data-level]")!.tabIndex = 0;
        half.querySelectorAll<HTMLButtonElement>("[data-tag]").forEach((tag) => {
          tag.setAttribute("aria-pressed", String(state.tags[state.day].includes(tag.dataset.tag!)));
          if (isLive) tag.removeAttribute("tabindex");
          else tag.tabIndex = -1;
        });
        half.querySelectorAll<HTMLButtonElement>("[data-day]").forEach((day) => {
          const index = Number(day.dataset.day);
          const on = index === state.day;
          const level = mood.levelOf(state.week[index]);
          day.setAttribute("aria-checked", String(on));
          day.setAttribute("aria-label", mood.dayLabel(state, index));
          day.tabIndex = isLive && on ? 0 : -1;
          day.setAttribute("style", tone(state.week[index]));
          day.querySelectorAll(".mood-bar").forEach((bar, at) => bar.classList.toggle("is-on", !!level && at < level.bars));
        });
      }
    }

    function roving(selector: string, pick: (index: number) => void): void {
      root.addEventListener("keydown", (event) => {
        const radio = (event.target as HTMLElement).closest<HTMLButtonElement>(selector);
        if (!radio) return;
        const group = [...radio.parentElement!.querySelectorAll<HTMLButtonElement>(selector)];
        const index = group.indexOf(radio);
        const to = { ArrowRight: index + 1, ArrowDown: index + 1, ArrowLeft: index - 1, ArrowUp: index - 1, Home: 0, End: group.length - 1 }[event.key];
        if (to === undefined) return;
        event.preventDefault();
        const next = (to + group.length) % group.length;
        pick(next);
        group[next].focus();
      });
    }

    root.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const level = target.closest<HTMLButtonElement>("[data-level]");
      const tag = target.closest<HTMLButtonElement>("[data-tag]");
      const day = target.closest<HTMLButtonElement>("[data-day]");
      root.dataset.touched = "";
      if (level) state = mood.chooseLevel(state, level.dataset.level!);
      else if (tag) state = mood.toggleTag(state, tag.dataset.tag!);
      else if (day) state = mood.chooseDay(state, Number(day.dataset.day));
      else return;
      draw();
    });
    roving("[data-level]", (index) => { root.dataset.touched = ""; state = mood.chooseLevel(state, mood.levels[index].key); draw(); });
    roving("[data-day]", (index) => { root.dataset.touched = ""; state = mood.chooseDay(state, index); draw(); });

    switches.forEach((button) => button.addEventListener("click", () => {
      live = button.dataset.moodSwitch!;
      root.dataset.live = live;
      switches.forEach((each) => each.setAttribute("aria-pressed", String(each === button)));
      draw();
    }));
  });
</script>
