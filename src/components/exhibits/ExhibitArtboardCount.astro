---
// audit graphic per figma 90:2638: the 114 original artboards as grey tiles beside the 34 rebuilt screens in
// the four card colours, an arrow between, each panel closed by its count and line. the words come from the
// spec text ("label | count | line | → | label | count | line"); the tiles are drawing and stay hidden.
interface Props {
  text: string;
}
const { text } = Astro.props;
const [fromLabel, fromCount, fromLine, , toLabel, toCount, toLine] = text.split(" | ");

// the tiles figma draws darker (55 percent rather than 22), by row of nineteen.
const darker = [[0, 7, 11, 14], [2, 3, 9, 14, 16], [4, 6, 11, 17, 18], [6, 9, 13], [1, 8, 12, 15], [3, 4, 10, 15, 17]];
const artboards = Array.from({ length: Number(fromCount) }, (_, index) => darker[Math.floor(index / 19)]?.includes(index % 19) ?? false);
// rebuilt screens cycle red, blue, green and orange, as the event cards do.
const colours = ["#dc3545", "#0069d9", "#00a650", "#f99953"];
const screens = Array.from({ length: Number(toCount) }, (_, index) => colours[index % colours.length]);
---
<div class="artboard-count">
  <div class="count-panel is-from">
    <p class="count-label">{fromLabel}</p>
    <div class="count-tiles" aria-hidden="true">{artboards.map((dark) => <i class:list={[dark && "is-dark"]}></i>)}</div>
    <p class="count-total"><span class="count-number">{fromCount}</span><span class="count-line">{fromLine}</span></p>
  </div>
  <span class="count-arrow" aria-hidden="true">→</span>
  <div class="count-panel is-to">
    <p class="count-label">{toLabel}</p>
    <div class="count-tiles" aria-hidden="true">{screens.map((colour) => <i style={`background: ${colour}`}></i>)}</div>
    <p class="count-total"><span class="count-number">{toCount}</span><span class="count-line">{toLine}</span></p>
  </div>
</div>
<style>
  /* a 1116 by 430 card: panels 48 and 700 in, tiles 75 down, counts 315 down. */
  .artboard-count { display: grid; grid-template-columns: minmax(0, 526px) minmax(48px, 126px) minmax(0, 372px); justify-content: start; padding: 39px 47px 45px; border: 1px solid var(--rule); border-radius: 6px; background: var(--surface); }
  .count-panel { display: grid; grid-template-rows: auto 210px auto; row-gap: 20px; min-width: 0; }
  .count-label { margin: 0; color: var(--muted); font: 11px / 16px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .count-tiles { display: grid; align-content: start; gap: 6px; }
  .is-from .count-tiles { grid-template-columns: repeat(19, minmax(0, 22px)); }
  .is-to .count-tiles { grid-template-columns: repeat(9, minmax(0, 30px)); }
  .count-tiles i { display: block; }
  .is-from .count-tiles i { aspect-ratio: 22 / 30; border-radius: 3px; background: #99a6b2; opacity: 0.22; }
  .is-from .count-tiles i.is-dark { opacity: 0.55; }
  .is-to .count-tiles i { aspect-ratio: 30 / 42; border-radius: 4px; }
  .count-arrow { align-self: start; margin-top: 120px; color: var(--color-annotate); font: 28px / 1 var(--ui); text-align: center; }
  .count-total { display: flex; align-items: flex-start; gap: 22px; margin: 10px 0 0; }
  .count-number { flex: none; color: var(--ink-strong); font: 400 48px / 1 var(--display); }
  .count-line { max-width: 420px; padding-top: 6px; color: var(--secondary); font: 15px / 21px var(--body); }
  .is-to .count-line { max-width: 300px; }

  @media (max-width: 860px) {
    .artboard-count { grid-template-columns: minmax(0, 1fr); row-gap: 24px; padding: 28px 20px; }
    .count-panel { grid-template-rows: auto auto auto; }
    .count-arrow { margin: 0; rotate: 90deg; justify-self: start; }
  }
</style>
