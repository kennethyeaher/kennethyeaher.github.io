---
// where every journey broke (figma 692:8): three personas by five aligned stages. each cell is the map's own stage
// name, the main pain, how the persona felt and the friction rating from the map; tyler's missing plan stage is a
// dashed empty box. the arrive and after columns are tinted accent soft under an orange mono tag.
//
// it is a real table, with explicit roles so the semantics survive the narrow layout, where the table turns into one
// card per persona with the five stages stacked (a container query, so the switch follows the column, not the
// viewport). in that layout each cell shows its aligned stage, which the column header carries on wide screens.
interface Cell { stage: string; pain: string; feels: string; rating: string }
interface EmptyCell { empty: true; label: string; body: string }
interface Props {
  id: string;
  caption: string;
  stages: string[];
  tags: Record<string, string>;
  ratingTones: Record<string, string>;
  personas: { name: string; role: string; cells: (Cell | EmptyCell)[] }[];
}
const { id, caption, stages, tags, ratingTones, personas } = Astro.props;
---
<div class="exhibit-breakdown">
  <table class="breakdown" role="table">
    <caption id={`${id}-caption`} class="sr-only">{caption}</caption>
    <colgroup><col class="col-persona" />{stages.map(() => <col />)}</colgroup>
    <thead role="rowgroup">
      <tr role="row">
        <td class="breakdown-corner" role="cell"></td>
        {stages.map((stage) => (
          <th scope="col" role="columnheader" class:list={[tags[stage] && "is-tinted"]}>
            {tags[stage] && <span class="stage-tag">{tags[stage]}</span>}
            <span class="stage-column">{stage}</span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody role="rowgroup">
      {personas.map((persona) => (
        <tr role="row">
          <th scope="row" role="rowheader">
            <span class="persona-name">{persona.name}</span>
            <span class="persona-role">{persona.role}</span>
          </th>
          {persona.cells.map((cell, index) => (
            <td role="cell" class:list={[tags[stages[index]] && "is-tinted"]}>
              {/* the aligned stage, shown only once the table is cards; the column header names it for screen readers. */}
              <span class="cell-column" aria-hidden="true">
                {stages[index]}{tags[stages[index]] && <span class="stage-tag"> · {tags[stages[index]]}</span>}
              </span>
              {"empty" in cell ? (
                <span class="cell-empty">
                  <span class="cell-stage">{cell.label}</span>
                  <span class="empty-body">{cell.body}</span>
                </span>
              ) : (
                <>
                  <span class="cell-stage">{cell.stage}</span>
                  <span class="cell-pain">{cell.pain}</span>
                  <span class="cell-feels">{cell.feels}</span>
                  <span class={`rating tone-${ratingTones[cell.rating] ?? "outline"}`}><span class="sr-only">Friction rating: </span>{cell.rating}</span>
                </>
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  /* the tinted columns' small text: --color-annotate and --muted read 4.19:1 and 4.17:1 on the light --accent-soft, so
     the light theme darkens both (5.02:1 and 4.98:1). the dark tint passes with the tokens (4.63:1 and 5.46:1). */
  .exhibit-breakdown { --tint-annotate: #ad3a0b; --tint-muted: #56636f; container-type: inline-size; }
  :global(:root[data-theme="dark"]) .exhibit-breakdown { --tint-annotate: var(--color-annotate); --tint-muted: var(--muted); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .exhibit-breakdown { --tint-annotate: var(--color-annotate); --tint-muted: var(--muted); }
  }

  .breakdown { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .col-persona { width: 140px; }
  .breakdown :is(th, td) { padding: 20px 16px 22px; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .breakdown thead :is(th, td) { padding-top: 18px; padding-bottom: 14px; vertical-align: bottom; }
  .breakdown tbody tr:last-child > * { border-bottom: 0; }
  .breakdown tbody th { padding-left: 0; }
  .is-tinted { background: var(--accent-soft); }
  .stage-column { display: block; color: var(--ink-strong); font: 12px / 1.4 var(--mono); letter-spacing: 0.08em; }
  .stage-tag { display: block; margin-bottom: 6px; color: var(--color-annotate); font: var(--label-micro, 10px) / 1.4 var(--mono); letter-spacing: 0.08em; }
  .is-tinted .stage-tag { color: var(--tint-annotate); }
  .persona-name { display: block; color: var(--ink-strong); font: 400 26px / 1.1 var(--display); letter-spacing: -0.01em; }
  .persona-role { display: block; margin-top: 6px; color: var(--muted); font: 400 14px / 1.35 var(--ui-sans); }
  td > span:not(.cell-column, .rating) { display: block; }
  .cell-column { display: none; }
  .cell-stage { color: var(--muted); font: var(--label-micro, 10px) / 1.4 var(--mono); letter-spacing: 0.08em; }
  .is-tinted .cell-stage { color: var(--tint-muted); }
  .cell-pain { margin-top: 10px; color: var(--ink-strong); font: 14px / 1.4 var(--ui-sans); }
  .cell-feels { margin-top: 10px; color: var(--ink); font: italic 15px / 1.35 var(--body); }
  .cell-empty { padding: 14px; border: 1px dashed var(--cord); border-radius: 8px; }
  .empty-body { display: block; margin-top: 8px; color: var(--muted); font: 14px / 1.4 var(--ui-sans); }

  /* rating chips (capstone-v2.md): moderate to high solid orange; moderate and mild to moderate solid accent; mild
     soft; not rated outlined and muted. */
  .rating { display: inline-block; margin-top: 12px; padding: 3px 8px; border: 1px solid transparent; border-radius: 999px; font: var(--label-micro, 10px) / 1.3 var(--mono); letter-spacing: 0.07em; }
  .tone-annotate { background: var(--color-annotate); color: var(--on-annotate); }
  .tone-accent { background: var(--accent); color: var(--on-accent); }
  .tone-soft { background: var(--accent-soft); color: var(--accent); }
  .tone-outline { border-color: var(--rule); color: var(--muted); }
  .is-tinted .tone-outline { border-color: var(--cord); color: var(--tint-muted); }

  /* one card per persona, the five stages stacked, below the width five readable columns need. */
  @container (max-width: 819px) {
    .breakdown, .breakdown :is(tbody, tr, th, td) { display: block; }
    .breakdown colgroup { display: none; }
    .breakdown thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .breakdown tbody { display: grid; gap: 16px; }
    .breakdown tbody tr { overflow: hidden; border: 1px solid var(--rule); border-radius: 12px; background: var(--surface); }
    .breakdown tbody :is(th, td) { padding: 16px 20px 18px; border-bottom: 1px solid var(--rule); }
    .breakdown tbody th { padding-left: 20px; }
    .breakdown tbody tr > :last-child { border-bottom: 0; }
    .persona-name, .persona-role { display: inline; }
    .persona-role { margin: 0 0 0 10px; }
    .cell-column { display: block; margin-bottom: 10px; color: var(--ink-strong); font: 11px / 1.4 var(--mono); letter-spacing: 0.08em; }
    .cell-column .stage-tag { display: inline; margin: 0; }
  }
</style>
