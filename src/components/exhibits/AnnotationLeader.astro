---
// leader annotation per figma 50:574 (dot, hairline, short label) and 53:609 (the vertical version,
// label dropping below). the box is the whole instance as a percentage of its host, like the spec gives it.
interface Props {
  num: string;
  label: string;
  at: { x: number; y: number; w: number; h?: number };
  order: number;
  vertical?: boolean;
  direction?: "right" | "left";
  theme?: "on-dark" | "on-light";
}
const { num, label, at, order, vertical = false, direction = "right", theme = "on-dark" } = Astro.props;
const box = vertical
  ? `left: ${at.x}%; top: ${at.y}%; width: ${at.w}%; height: ${at.h ?? 20}%`
  : `left: ${at.x}%; top: ${at.y}%; width: ${at.w}%`;
---
<span class:list={["annotation", "annotation-leader", vertical ? "is-vertical" : `is-${direction}`, theme]} style={`${box}; --order: ${order}`} data-annotation>
  <span class="leader-anchor" aria-hidden="true"></span>
  <span class="leader-line" aria-hidden="true"></span>
  <span class="leader-label"><span class="leader-number">{num}</span><span class="leader-text">{label}</span></span>
</span>
<style>
  .annotation-leader { position: absolute; z-index: 3; display: flex; align-items: center; }
  .annotation-leader.is-left { flex-direction: row-reverse; }
  .annotation-leader.is-vertical { flex-direction: column; }
  .leader-anchor { flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--color-annotate); box-shadow: 0 0 0 2.5px #fff, 0 1px 4px 2.5px rgb(0 0 0 / 25%); }
  .leader-line { flex: 1 1 0; min-width: 1px; height: 1px; transform-origin: left center; }
  .is-left .leader-line { transform-origin: right center; }
  .is-vertical .leader-line { width: 1px; min-height: 1px; height: auto; transform-origin: center top; }
  .on-light .leader-line { background: rgb(38 51 64 / 45%); }
  .on-dark .leader-line { background: rgb(255 255 255 / 70%); }
  .leader-label { display: grid; flex: none; gap: 2px; padding-left: 10px; white-space: nowrap; }
  .is-left .leader-label { padding: 0 10px 0 0; justify-items: end; text-align: right; }
  .is-vertical .leader-label { padding: 10px 0 0; justify-items: center; text-align: center; }
  .leader-number { color: var(--color-annotate); font: 10px / 1.3 var(--mono); letter-spacing: 0.06em; }
  .on-dark .leader-number { color: var(--color-annotate-on-stage); }
  .on-light .leader-number { color: var(--color-annotate-on-light-stage); }
  .on-light .leader-anchor { background: var(--color-annotate-on-light-stage); }
  /* labels keep figma's 13px, and shrink with a narrow stage (below 534 wide) so neighbours never collide, down to 10px. */
  .leader-text { font: 500 clamp(10px, 2.43cqw, 13px) / 1.4 var(--ui); }
  .leader-number { font-size: clamp(9px, 1.87cqw, 10px); }
  .on-light .leader-text { color: #273440; }
  .on-dark .leader-text { color: #fff; text-shadow: 0 1px 6px rgb(0 0 0 / 45%); }
</style>
