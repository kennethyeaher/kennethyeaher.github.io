---
// leader annotation per figma 50:574 (dot, hairline, short label) and 53:609 (the vertical version,
// label dropping below). the box is the whole instance as a percentage of its host, like the spec gives it.
interface Props {
  num: string;
  label: string;
  at: { x: number; y: number; w: number; h?: number };
  order: number;
  vertical?: boolean;
  /** a vertical leader's label sits under its line by default; above puts it on top, the anchor at the foot (elms 426:2749). */
  direction?: "right" | "left" | "above";
  theme?: "on-dark" | "on-light";
  /** figma 197:1727: on a zoom stage, the region the leader points at, a share of the stage like a focus box. it
      renders as an invisible box after the leader for the zoom to frame (src/scripts/pin-zoom.ts), and the label
      becomes the button that opens it. */
  zoomAt?: { x: number; y: number; w: number; h: number };
}
const { num, label, at, order, vertical = false, direction = "right", theme = "on-dark", zoomAt } = Astro.props;
const box = vertical
  ? `left: ${at.x}%; top: ${at.y}%; width: ${at.w}%; height: ${at.h ?? 20}%`
  : `left: ${at.x}%; top: ${at.y}%; width: ${at.w}%`;
---
<span class:list={["annotation", "annotation-leader", vertical ? "is-vertical" : `is-${direction}`, vertical && direction === "above" && "is-above", theme]} style={`${box}; --order: ${order}`} data-annotation={zoomAt ? num : true} data-zoom-title={zoomAt && label}>
  <span class="leader-anchor" aria-hidden="true"></span>
  <span class="leader-line" aria-hidden="true"></span>
  <span class="leader-label"><span class="leader-number">{num}</span><span class="leader-text">{label}</span><span class="leader-dot" aria-hidden="true">{num}</span></span>
</span>
{zoomAt && <span class="leader-target" style={`left: ${zoomAt.x}%; top: ${zoomAt.y}%; width: ${zoomAt.w}%; height: ${zoomAt.h}%`} aria-hidden="true"></span>}
<style>
  .annotation-leader { position: absolute; z-index: 3; display: flex; align-items: center; }
  .annotation-leader.is-left { flex-direction: row-reverse; }
  .annotation-leader.is-vertical { flex-direction: column; }
  .annotation-leader.is-vertical.is-above { flex-direction: column-reverse; }
  .leader-anchor { flex: none; width: 9px; height: 9px; border-radius: 50%; background: var(--color-annotate); box-shadow: 0 0 0 2.5px #fff, 0 1px 4px 2.5px rgb(0 0 0 / 25%); }
  .leader-line { flex: 1 1 0; min-width: 1px; height: 1px; transform-origin: left center; }
  .is-left .leader-line { transform-origin: right center; }
  .is-vertical .leader-line { width: 1px; min-height: 1px; height: auto; transform-origin: center top; }
  .is-above .leader-line { transform-origin: center bottom; }
  .on-light .leader-line { background: rgb(38 51 64 / 45%); }
  .on-dark .leader-line { background: rgb(255 255 255 / 70%); }
  /* text-align is pinned because the label becomes a button on a zoom stage (figma 197:1727), and a button centres text. */
  .leader-label { display: grid; flex: none; gap: 2px; padding-left: 10px; white-space: nowrap; text-align: start; }
  .leader-target { position: absolute; z-index: 3; border-radius: 10px; pointer-events: none; }
  .is-left .leader-label { padding: 0 10px 0 0; justify-items: end; text-align: right; }
  .is-vertical .leader-label { padding: 10px 0 0; justify-items: center; text-align: center; }
  .is-above .leader-label { padding: 10px 0 0; }
  .leader-number { color: var(--color-annotate); font: 10px / 1.3 var(--mono); letter-spacing: 0.06em; }
  .on-dark .leader-number { color: var(--color-annotate-on-stage); }
  .on-light .leader-number { color: var(--color-annotate-on-light-stage); }
  .on-light .leader-anchor { background: var(--color-annotate-on-light-stage); }
  /* labels keep figma's 13px, and shrink with a narrow stage (below 534 wide) so neighbours never collide, down to 10px.
     on phones the numeral holds the 10px badge size (global.css --badge-numeral). */
  .leader-text { font: 500 clamp(10px, 2.43cqw, 13px) / 1.4 var(--ui); }
  .leader-number { font-size: var(--badge-numeral, clamp(9px, 1.87cqw, 10px)); }
  /* the dot centres on the label, so on phones the larger numeral keeps the line it had and the dot never moves. */
  @media (max-width: 640px) {
    .leader-number { line-height: calc(1.3 * clamp(9px, 1.87cqw, 10px)); }
  }
  .on-light .leader-text { color: #273440; }
  .on-dark .leader-text { color: #fff; text-shadow: 0 1px 6px rgb(0 0 0 / 45%); }
  .leader-dot { display: none; }
  /* on phones a label running sideways off a 350 wide stage gets clipped, so a leader is only its numbered dot on the
     anchor and LeaderLegend lists the labels under the stage. the label keeps its size and its text, unseen, so the
     anchor stays where figma put it and the name stays in the accessibility tree. the label is the zoom's button, so
     the dot is drawn inside it: a 22px badge like a focus box's, with a 44px hit area, on the anchor's centre. */
  @media (max-width: 640px) {
    .leader-line { display: none; }
    .leader-anchor { visibility: hidden; }
    .leader-label { position: relative; width: 0; min-width: 0; padding: 0; }
    .is-left .leader-label, .is-vertical .leader-label { padding: 0; }
    .leader-number, .on-dark .leader-number, .on-light .leader-number { color: transparent; }
    .leader-text { color: transparent; text-shadow: none; pointer-events: none; }
    .on-light .leader-text, .on-dark .leader-text { color: transparent; text-shadow: none; }
    /* the anchor's centre, from the zero wide label beside it (4.5px is half the 9px anchor): left of a label that
       points right, right of one that points left, above a vertical one. */
    .leader-dot {
      position: absolute;
      top: 50%;
      left: -4.5px;
      display: grid;
      place-items: center;
      box-sizing: border-box;
      width: 22px;
      height: 22px;
      border: 2px solid #fff;
      border-radius: 50%;
      background: var(--color-annotate);
      color: var(--on-annotate);
      font: var(--badge-numeral, 10px) / 1 var(--mono);
      translate: -50% -50%;
    }
    .is-left .leader-dot { left: 4.5px; }
    .is-vertical .leader-dot { top: -4.5px; left: 0; }
    /* a label above its line has the anchor straight under it once the line is gone. */
    .is-vertical.is-above .leader-dot { top: calc(100% + 4.5px); }
    .on-light .leader-dot { background: var(--color-annotate-on-light-stage); color: #fff; }
    .leader-dot::before { position: absolute; inset: -11px; content: ""; }
    .leader-label:focus-visible { outline: none; }
    .leader-label:focus-visible .leader-dot { outline: 2px solid #fff; outline-offset: 2px; box-shadow: 0 0 0 5px var(--color-annotate); }
  }
</style>
