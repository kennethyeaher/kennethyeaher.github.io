---
// exhibit section head per figma 50:581: a mono eyebrow over a display heading.
interface Props {
  eyebrow: string;
  heading: string;
  id?: string;
  /** 3 for a head inside a chapter, such as a live specimen's. */
  level?: 2 | 3;
}
const { eyebrow, heading, id, level = 2 } = Astro.props;
const Heading = level === 3 ? "h3" : "h2";
---
<header class="section-head">
  <p class="section-eyebrow">{eyebrow}</p>
  <Heading id={id}>{heading}</Heading>
</header>
<style>
  .section-head { display: grid; gap: 14px; max-width: 760px; }
  .section-eyebrow { margin: 0; color: var(--muted); font: 11px / 14px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
  :is(h2, h3) { margin: 0; color: var(--ink-strong); font: 400 clamp(26px, 3vw, 32px) / 1.1 var(--display); letter-spacing: -0.015em; }
</style>
