---
// exhibit section head per figma 50:581: a mono eyebrow over a display heading.
interface Props {
  eyebrow: string;
  heading: string;
  id?: string;
}
const { eyebrow, heading, id } = Astro.props;
---
<header class="section-head">
  <p class="section-eyebrow">{eyebrow}</p>
  <h2 id={id}>{heading}</h2>
</header>
<style>
  .section-head { display: grid; gap: 14px; max-width: 760px; }
  .section-eyebrow { margin: 0; color: var(--muted); font: 11px / 14px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--ink-strong); font: 400 clamp(26px, 3vw, 32px) / 1.1 var(--display); letter-spacing: -0.015em; text-wrap: balance; }
</style>
