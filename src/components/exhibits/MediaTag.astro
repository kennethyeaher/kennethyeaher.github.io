---
// media tag per figma 50:584, marking a stage that ships as a looping muted clip.
interface Props {
  text: string;
}
const { text } = Astro.props;
---
<span class="media-tag"><span class="media-dot" aria-hidden="true"></span>{text}</span>
<style>
  .media-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px 5px 8px;
    border-radius: 999px;
    background: rgb(0 0 0 / 45%);
    backdrop-filter: blur(6px);
    color: #fff;
    font: 10px / 1 var(--mono);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  /* drawn from the annotate token rather than the figma svg, so the site keeps one annotation colour. */
  .media-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-annotate-on-stage); }
</style>
