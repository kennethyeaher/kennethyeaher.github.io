---
// audit cards per figma 56:752, built in html from the spec text. cards are separated by " || " and
// fields by " | ": label, value, what it means, then the mechanism and guard, each after its own heading.
interface Props {
  text: string;
  footnote?: string;
}
const { text, footnote } = Astro.props;
const cards = text.split(" || ").map((card) => {
  const [label, value, meaning, mechanismLabel, mechanism, guardLabel, guard] = card.split(" | ");
  return { label, value, meaning, mechanismLabel, mechanism, guardLabel, guard };
});
---
<ol class="audit-cards">
  {cards.map((card) => (
    <li>
      <p class="audit-label">{card.label}</p>
      <p class="audit-value">{card.value}</p>
      <p class="audit-meaning">{card.meaning}</p>
      <dl>
        <dt class="audit-heading">{card.mechanismLabel}</dt>
        <dd class="audit-mechanism">{card.mechanism}</dd>
        <dt class="audit-heading is-guard">{card.guardLabel}</dt>
        <dd class="audit-guard">{card.guard}</dd>
      </dl>
    </li>
  ))}
</ol>
{footnote && <p class="audit-footnote">{footnote}</p>}
<style>
  .audit-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .audit-cards li { padding: 25px; border: 1px solid var(--rule); border-radius: 10px; background: var(--surface); }
  :where(.audit-cards) :is(p, dl, dd) { margin: 0; }
  .audit-label { color: var(--muted); font: 10px / 1.3 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .audit-value { margin-top: 14px; color: var(--ink-strong); font: 400 44px / 50px var(--display); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .audit-meaning { margin-top: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--rule); color: var(--secondary); font: 15px / 21px var(--body); }
  .audit-heading { margin-top: 14px; color: var(--muted); font: 10px / 1.3 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .audit-heading.is-guard { color: var(--color-annotate); }
  .audit-mechanism { margin-top: 14px; color: var(--ink); font: 15px / 21px var(--body); }
  .audit-guard { margin-top: 14px; color: var(--ink-strong); font: 500 13px / 20px var(--ui); }
  .audit-footnote { max-width: 860px; margin: 32px 0 0; padding-left: 20px; border-left: 2px solid var(--color-annotate); color: var(--ink-strong); font: 400 20px / 30px var(--display); letter-spacing: -0.01em; }
</style>
