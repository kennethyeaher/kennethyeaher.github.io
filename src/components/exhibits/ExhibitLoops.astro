---
// laptop loops after a stage's caption (frontground offline and triage, .private/fg-loops/hifi). the laptop and the
// blurred colour field are baked into each video, so a card is only a rounded box in the loops' base colour that the
// clip fills, with the media tag and its pause control in the bottom left corner (132:1838). a pair sets two cards
// side by side with their captions under them (figma 325:506); a feature sets one card beside its caption and the
// steps it plays (325:545); both layouts are global.css's .exhibit-layout, which the live specimens share. a wide card
// stands in for a whole stage at the stage's width, with no caption (sohive's four phone loops); two stack where a stage
// and the stage under it stood (terpcarehub's alert and find care), each on its own base. on phones the tag
// drops under the card, so it never covers the device. a card whose loop is null is a still waiting for its recording
// (elms): it draws its poster in the same box, so the clip drops in later with no layout change, and its tag, if it
// has one, is a plain tag with no control. a loop with motion is drawn in html (ExhibitMotionLoop, elms's core flow cards)
// and takes the same tag and control as a clip.
import Caption from "@/components/exhibits/Caption.astro";
import ExhibitLoop from "@/components/exhibits/ExhibitLoop.astro";
import ExhibitMotionLoop from "@/components/exhibits/ExhibitMotionLoop.astro";
import MediaTag from "@/components/exhibits/MediaTag.astro";

interface Props {
  layout: "pair" | "feature" | "wide";
  visuals: { src: string; alt: string; width: number; height: number; base?: string; loop: { src: string; poster: string; name?: string } | { motion: string; name?: string } | null }[];
  /** a wide card's caption carries only its tag. */
  captions: { num?: string; tag?: string; title?: string; body?: string }[];
  base: string;
  /** a feature's steps, in the order the loop plays them. */
  steps?: string[];
}
const { layout, visuals, captions, base, steps = [] } = Astro.props;
---
<div class:list={["exhibit-loops", layout !== "wide" && "exhibit-layout", `is-${layout}`]}>
  {visuals.map((visual, index) => (
    <figure class="loop-exhibit">
      <div class="loop-media">
        <div class="loop-card" style={`--loop-base: ${visual.base ?? base}; aspect-ratio: ${visual.width} / ${visual.height}`}>
          {visual.loop && "motion" in visual.loop
            ? <ExhibitMotionLoop motion={visual.loop.motion} label={visual.alt} name={visual.loop.name} />
            : visual.loop
            ? <ExhibitLoop src={visual.loop.src} poster={visual.loop.poster} width={visual.width} height={visual.height} label={visual.alt} name={visual.loop.name} />
            : <img class="loop-still-card" src={visual.src} alt={visual.alt} width={visual.width} height={visual.height} loading="lazy" decoding="async" />}
        </div>
        {captions[index].tag && <span class="loop-tag"><MediaTag text={captions[index].tag!} loop={visual.loop ? visual.loop.name ?? "" : undefined} /></span>}
      </div>
      {captions[index].title && <figcaption class="loop-caption">
        {captions[index].num && <p class="loop-num">{captions[index].num}</p>}
        <Caption title={captions[index].title!} body={captions[index].body!} />
        {layout === "feature" && steps.length > 0 && (
          <ol class="loop-steps">
            {steps.map((step, stepIndex) => (
              <li><span class="step-num">{String(stepIndex + 1).padStart(2, "0")}</span><span class="step-text">{step}</span></li>
            ))}
          </ol>
        )}
      </figcaption>}
    </figure>
  ))}
</div>
<style>
  /* figma 325:506: two 538 wide cards 40 apart, each with its caption 20 under it (global.css .exhibit-layout.is-pair).
     figma 325:545: the 720 card and the 348 column of caption and steps, 48 apart, centred on each other. */
  .exhibit-loops { --feature-columns: 720fr 348fr; margin-top: 56px; }
  /* a wide card takes the stage's place, straight under the lede. */
  .exhibit-loops.is-wide { display: grid; gap: 32px; margin-top: 0; }
  /* row-gap only, so a feature keeps the shared layout's 48 between its columns. */
  .loop-exhibit { display: grid; align-content: start; row-gap: 20px; margin: 0; }
  .loop-media { position: relative; display: grid; }
  /* the radius the other stages use; the clip fills the box at its own ratio. */
  .loop-card { position: relative; overflow: hidden; border-radius: 6px; background: var(--loop-base); }
  .loop-card :global(.exhibit-loop) { height: 100%; }
  .loop-card :global(.exhibit-loop video) { height: 100%; object-fit: cover; }
  .loop-still-card { display: block; width: 100%; height: 100%; object-fit: cover; }
  .loop-tag { position: absolute; z-index: 2; bottom: 16px; left: 16px; }
  .loop-caption { display: grid; justify-items: start; gap: 6px; }
  .loop-caption :global(.exhibit-caption) { max-width: 480px; }
  .is-feature .loop-caption :global(.exhibit-caption) { max-width: none; }
  .loop-num { margin: 0; color: var(--color-annotate); font: var(--label-micro, 10px) / 13px var(--mono); letter-spacing: var(--label-micro-tracking, 0.06em); }
  /* the steps sit under a 1px rule, 18 below the caption, 10 apart. */
  .loop-steps { display: grid; gap: 10px; width: 100%; margin: 12px 0 0; padding: 10px 0 0; border-top: 1px solid var(--rule); list-style: none; }
  .loop-steps li { display: flex; align-items: baseline; gap: 14px; }
  .step-num { flex: none; color: var(--color-annotate); font: 11px / 14px var(--mono); }
  .step-text { color: var(--ink-strong); font: 500 14px / 18px var(--ui-sans); }
  @media (max-width: 760px) {
    /* one column: a feature's card comes first, then its caption and steps. */
    .exhibit-loops { margin-top: 40px; }
    .exhibit-loops.is-wide { margin-top: 0; }
    .is-feature .loop-exhibit { gap: 20px; }
  }
  /* on phones the card is too small for the tag to sit on it without covering the device, so it drops 10 under. */
  @media (max-width: 640px) {
    .loop-media { gap: 10px; }
    .loop-tag { position: static; justify-self: start; }
  }
</style>
