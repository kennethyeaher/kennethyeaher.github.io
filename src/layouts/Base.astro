---
// Shared editorial shell for every portfolio route.
import "@/styles/global.css";
import { profile } from "@/data/portfolio.mjs";
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, image, imageAlt } = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | Portfolio`;
const pageDescription = description ?? profile.intro;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? "/images/portfolio-preview-2026.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // apply the saved preference before the first paint, including when storage is unavailable.
      try {
        const saved = localStorage.getItem("portfolio-theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8fafb" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? `${profile.name}, ${profile.roleLine}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      import "@/scripts/site.ts";
    </script>
  </body>
</html>
