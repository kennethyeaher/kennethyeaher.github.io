---
// Shared editorial shell for every portfolio route.
import "@/styles/global.css";
import { profile } from "@/data/portfolio.mjs";
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /** A case study title: the header shows a breadcrumb back to Work in place of the name. */
  crumb?: string;
}

const { title, description, image, imageAlt, crumb } = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | Portfolio`;
const pageDescription = description ?? profile.intro;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image ?? "/images/portfolio-preview-2026.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // with scripts on, the theme cord shows from the first paint.
      document.documentElement.classList.add("nav-ready");
      // apply the saved preference before the first paint, including when storage is unavailable.
      try {
        const saved = localStorage.getItem("portfolio-theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
      // only the clicked card carries view transition names, matched to its case study hero, so home names two
      // elements instead of sixteen. pagereveal must be listening before the first render, hence the head.
      const cardFor = (url) => url && document.querySelector(`.project-card[href="${new URL(url).pathname.replace(/\/$/, "")}"]`);
      const nameCard = (card, on) => {
        if (!card) return;
        const slug = card.getAttribute("href").split("/").pop();
        card.querySelector(".project-cover").style.viewTransitionName = on ? `cover-${slug}` : "";
        card.querySelector("h3").style.viewTransitionName = on ? `title-${slug}` : "";
      };
      addEventListener("pageswap", (event) => {
        if (event.viewTransition) nameCard(cardFor(event.activation?.entry.url), true);
      });
      addEventListener("pagereveal", (event) => {
        document.querySelectorAll(".project-card").forEach((card) => nameCard(card, false));
        if (!event.viewTransition) return;
        // a page to page transition fades through (global.css); same page ones keep the crossfade.
        document.documentElement.classList.add("is-page-transition");
        const card = cardFor(window["navigation"]?.activation?.from?.url);
        nameCard(card, true);
        // finished rejects when the transition fails; the name is cleared either way, so the rejection is dropped.
        event.viewTransition.finished.finally(() => nameCard(card, false)).catch(() => {});
        event.viewTransition.finished.finally(() => document.documentElement.classList.remove("is-page-transition")).catch(() => {});
      });
      // the dot cursor carries over: src/scripts/pointer-dot.ts saves where it was as the last page went, and it is put
      // back here before the first paint, so the native arrow never shows. fine hovering mice only, and only straight
      // after a navigation, not when the tab comes back much later.
      try {
        const pointer = JSON.parse(sessionStorage.getItem("portfolio-pointer") ?? "null");
        if (pointer && Date.now() - pointer.t < 10000 && matchMedia("(hover: hover) and (pointer: fine)").matches && !matchMedia("(forced-colors: active)").matches) {
          document.documentElement.classList.add("is-pointing");
          document.documentElement.style.setProperty("--pointer-x", `${pointer.x}px`);
          document.documentElement.style.setProperty("--pointer-y", `${pointer.y}px`);
        }
      } catch {}
    </script>
    <!-- the home h1 (the lcp text) is fraunces, and the header name and links are geist, which has no metric matched fallback. -->
    <link rel="preload" href="/fonts/fraunces/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist/geist-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8fafb" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? `${profile.name}, ${profile.roleLine}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Nav crumb={crumb} />
    <main id="main-content" class:list={[!crumb && "beside-rail"]}>
      <slot />
    </main>
    <Footer />
    {/* the dot cursor: hidden until the script makes it the pointer for a fine hovering mouse. */}
    <div class="pointer-dot" data-pointer-dot aria-hidden="true"><span class="pointer-dot-mark"></span><span class="pointer-dot-chip"></span></div>
    {/* the zoom bar per figma 168:1745, cloned into a stage by src/scripts/pin-zoom.ts while it is zoomed and removed after. */}
    <template data-zoom-bar><div class="zoom-bar"><span class="zoom-title" aria-live="polite"></span><div class="zoom-controls"><button type="button" aria-label="Previous note">‹</button><button type="button" aria-label="Next note">›</button><button type="button" aria-label="Close zoom">✕</button></div></div></template>

    <script>
      import "@/scripts/site.ts";
    </script>
  </body>
</html>
