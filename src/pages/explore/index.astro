---
// Explore v5 browse, the Reel (figma 630:20084): one row per piece, newest first, a 420 square motion cover beside a
// 400 wide text block, the sides swapping row to row. ALL / PERSONAL / SCHOOL filters by category and keeps its choice
// in ?filter=. with scripts off every row shows with its poster and the filter stays hidden.
import Base from "@/layouts/Base.astro";
import { exploreCategories, exploreItems } from "@/data/explore.mjs";
---

<Base title="Explore" description="Personal and school work by Kenneth Yeaher, one moving cover at a time.">
  <div class="reel" data-reel>
    <h1 class="sr-only">Explore</h1>
    <div class="reel-bar">
      <p class="reel-eyebrow">EXPLORE  ·  REEL</p>
      <div class="reel-filter" role="group" aria-label="Filter">
        {exploreCategories.map((category, index) => (
          <button type="button" data-filter-button={category.id} aria-pressed={index === 0 ? "true" : "false"}>{category.label}</button>
        ))}
      </div>
    </div>
    <ol class="reel-list">
      {
        exploreItems.map((item, index) => (
          <li class="reel-row" data-reel-row data-category={item.category} data-side={index % 2 === 0 ? "start" : "swap"}>
            <a class="reel-link" href={`/explore/${item.id}`} data-astro-prefetch="viewport">
              <div class="reel-cover" data-cursor="card" data-cursor-label={`View ${item.title}`}>
                <video
                  class="reel-video"
                  data-reel-video
                  muted
                  loop
                  playsinline
                  preload="none"
                  poster={item.cover.poster}
                  width="420"
                  height="420"
                  aria-hidden="true"
                  tabindex="-1"
                >
                  <source src={item.cover.video} type="video/mp4" />
                </video>
              </div>
              <div class="reel-text">
                <span class="reel-code">{item.code}</span>
                <h2 class="reel-title">{item.title}</h2>
                <p class="reel-line">{item.line}</p>
                <p class="reel-tags">{item.tags}</p>
                <span class="reel-open">Open →</span>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
    {/* the filter comes from ?filter= before the first paint, so back and refresh land on the same rows. the shown rows
        take turns, cover first then text first, whatever the filter leaves. */}
    <script is:inline>
      {
        const root = document.currentScript.parentElement;
        const asked = new URLSearchParams(location.search).get("filter");
        const filter = asked === "personal" || asked === "school" ? asked : "all";
        root.dataset.filter = filter;
        root.querySelectorAll("[data-filter-button]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.filterButton === filter)));
        let shown = 0;
        root.querySelectorAll("[data-reel-row]").forEach((row) => {
          row.hidden = filter !== "all" && row.dataset.category !== filter;
          if (!row.hidden) row.dataset.side = shown++ % 2 === 0 ? "start" : "swap";
        });
      }
    </script>
  </div>
</Base>

<script>
  import "@/scripts/explore-reel.ts";
</script>

<style>
  /* the home column: 924px centred on the screen (x=258 at 1440), clear of the rail. the eyebrow sits at y=200, level
     with the rail, and the first row 64px below its top. the footer's 96px margin and 24px padding would put the credit
     120px under the last cover; figma has 108. */
  .reel {
    width: min(924px, 100% - 48px);
    margin-bottom: -12px;
    margin-left: max(24px, (100% - 924px) / 2 - 48px);
    padding-top: 136px;
  }

  /* jetbrains mono 12, spacing 8%, muted; the filter at the column's right edge, 24px apart. */
  .reel-bar {
    display: flex;
    margin-bottom: 48px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .reel-eyebrow {
    margin: 0;
    color: var(--muted);
    font: 12px / 16px var(--mono);
    letter-spacing: 0.08em;
    white-space: pre;
  }

  /* scripts off: every row shows, so the filter has nothing to do. */
  .reel-filter {
    display: none;
    gap: 24px;
  }

  :global(.nav-ready) .reel-filter {
    display: flex;
  }

  .reel-filter button {
    margin-block: -6px;
    padding: 6px 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    font: 400 12px / 16px var(--mono);
    letter-spacing: 0.08em;
    transition: color 180ms ease;
  }

  .reel-filter button:hover {
    color: var(--ink);
  }

  .reel-filter button[aria-pressed="true"] {
    color: var(--color-annotate);
    font-weight: 500;
  }

  .reel-list {
    display: grid;
    margin: 0;
    padding: 0;
    gap: 96px;
    list-style: none;
  }

  .reel-row[hidden] {
    display: none;
  }

  /* even rows: cover at x=258, text at x=738 (60px gap, 44px spare). odd rows: text at x=258, cover at x=762 (104px
     gap). fractions of the 924 column, so the rows narrow together between phone and desktop. */
  .reel-link {
    display: grid;
    align-items: start;
    color: var(--ink-strong);
    grid-template-columns: minmax(0, 420fr) minmax(0, 60fr) minmax(0, 400fr) minmax(0, 44fr);
  }

  .reel-cover {
    grid-column: 1;
    grid-row: 1;
  }

  .reel-text {
    grid-column: 3;
    grid-row: 1;
    padding-top: 90px;
  }

  .reel-row[data-side="swap"] .reel-link {
    grid-template-columns: minmax(0, 400fr) minmax(0, 104fr) minmax(0, 420fr);
  }

  .reel-row[data-side="swap"] .reel-cover {
    grid-column: 3;
  }

  .reel-row[data-side="swap"] .reel-text {
    grid-column: 1;
  }

  .reel-video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    background: var(--surface-sunken);
    object-fit: cover;
  }

  /* code mono 12 orange; title fraunces 34 26px under the code's top; line geist 15 14px under the title; tags mono 11
     18px under; "Open →" geist 14 22px under. */
  .reel-code {
    display: block;
    color: var(--color-annotate);
    font: 12px / 16px var(--mono);
    letter-spacing: 0.08em;
  }

  .reel-title {
    margin: 10px 0 0;
    color: var(--ink-strong);
    font: 400 34px / 1.1 var(--display);
    letter-spacing: -0.02em;
  }

  .reel-line {
    max-width: 380px;
    margin: 14px 0 0;
    color: var(--ink);
    font: 15px / 1.5 var(--ui-sans);
  }

  .reel-tags {
    margin: 18px 0 0;
    color: var(--muted);
    font: 11px / 14px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reel-open {
    display: inline-block;
    margin-top: 22px;
    color: var(--ink-strong);
    font: 14px / 20px var(--ui-sans);
  }

  .reel-link:hover .reel-open {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 980px) {
    .reel {
      width: auto;
      margin-left: 0;
      padding-inline: 20px;
      padding-top: 40px;
    }
  }

  /* phones: one column, the cover full width and the text 20px under it, no alternation; rows 64px apart. */
  @media (max-width: 767px) {
    .reel-bar {
      margin-bottom: 32px;
    }

    .reel-list {
      gap: 64px;
    }

    .reel-link,
    .reel-row[data-side="swap"] .reel-link {
      grid-template-columns: minmax(0, 1fr);
    }

    .reel-cover,
    .reel-text,
    .reel-row[data-side="swap"] .reel-cover,
    .reel-row[data-side="swap"] .reel-text {
      grid-column: 1;
      grid-row: auto;
    }

    .reel-text {
      padding-top: 20px;
    }
  }

  /* the 375 frame puts the credit 40px under the last row, with the footer's 72px phone margin. */
  @media (max-width: 620px) {
    .reel {
      margin-bottom: -56px;
    }
  }
</style>
