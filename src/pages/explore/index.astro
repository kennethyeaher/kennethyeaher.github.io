---
// Explore: school and personal work as square tiles under a School / Personal toggle (figma 299:1843, 299:2016,
// 299:2170, 300:1850, 300:1959), after yeezy.com's male / female grid. with scripts off both categories show as two
// labelled lists.
import Base from "@/layouts/Base.astro";
import { exploreCategories, exploreItems, visualBackground } from "@/data/explore.mjs";

const sections = exploreCategories.map((category) => ({
  ...category,
  items: exploreItems.filter((item) => item.category === category.id),
}));
---

<Base title="Explore" description="School and personal work by Kenneth Yeaher, one square at a time.">
  <div class="explore" data-explore data-view="school" data-size="many">
    <h1 class="sr-only">Explore</h1>
    <div class="explore-bar">
      <div class="explore-toggle" role="group" aria-label="Category">
        {sections.map((category, index) => (
          <button type="button" data-view-button={category.id} aria-pressed={index === 0 ? "true" : "false"}>{category.label}</button>
        ))}
      </div>
      {/* + goes to fewer, larger tiles and becomes a minus; the label says what it will do. */}
      <button type="button" class="explore-size" data-size-button aria-label="Show 2 per row">
        <span class="explore-size-bar" aria-hidden="true"></span>
        <span class="explore-size-bar is-vertical" aria-hidden="true"></span>
      </button>
    </div>
    {/* the view comes from ?view= before the first paint, so back and refresh land on the same category. */}
    <script is:inline>
      {
        const root = document.currentScript.parentElement;
        const view = new URLSearchParams(location.search).get("view") === "personal" ? "personal" : "school";
        root.dataset.view = view;
        root.querySelectorAll("[data-view-button]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.viewButton === view)));
      }
    </script>
    {
      sections.map((category) => (
        <section class="explore-section" data-category={category.id} aria-labelledby={`explore-${category.id}`}>
          <h2 id={`explore-${category.id}`} class="explore-heading">{category.label}</h2>
          <ul class="explore-grid">
            {category.items.map((item) => {
              const visual = item.visuals[0];
              return (
                <li>
                  <a class="explore-tile" href={`/explore/${item.id}`} data-cursor="card" data-cursor-label={`View ${item.code}`}>
                    {"src" in visual ? (
                      <img class="explore-visual" src={visual.src} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <div class="explore-visual" aria-hidden="true" style={`background-image: ${visualBackground(visual)}`} />
                    )}
                    <span class="explore-code">{item.code}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<script>
  import "@/scripts/explore.ts";
</script>

<style>
  /* the home column: 924px centred on the screen (x=258 at 1440), clear of the rail. the toggle sits at y=200, level
     with the rail, and the grid 64px below its top. the bottom margin collapses with the footer's 96px one, so the
     credit sits 74px under the last row. */
  .explore {
    width: min(924px, 100% - 48px);
    margin-bottom: -46px;
    margin-left: max(24px, (100% - 924px) / 2 - 48px);
    padding-top: 136px;
  }

  /* scripts off: no toggle, and the categories stack under their names. */
  .explore-bar {
    display: none;
  }

  .explore-section + .explore-section {
    margin-top: 72px;
  }

  .explore-heading {
    margin: 0 0 24px;
    color: var(--muted);
    font: 15px / 20px var(--mono);
    text-transform: uppercase;
  }

  :global(.nav-ready) .explore-bar {
    display: grid;
    margin-bottom: 44px;
    align-items: center;
    grid-template-columns: 1fr auto 1fr;
    /* one 20px row; the 32px size target overflows it evenly, so the plus stays level with the labels. */
    grid-template-rows: 20px;
  }

  :global(.nav-ready) .explore-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  :global(.nav-ready) .explore-section + .explore-section {
    margin-top: 0;
  }

  :global(.nav-ready) .explore[data-view="school"] [data-category="personal"],
  :global(.nav-ready) .explore[data-view="personal"] [data-category="school"] {
    display: none;
  }

  /* jetbrains mono 15, 24px apart: the current category --color-annotate, the other --muted. dims by colour. */
  .explore-toggle {
    display: flex;
    grid-column: 2;
    gap: 24px;
  }

  .explore-toggle button {
    margin-block: -2px;
    padding: 2px 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    font: 15px / 20px var(--mono);
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .explore-toggle button:hover {
    color: var(--ink);
  }

  .explore-toggle button[aria-pressed="true"] {
    color: var(--color-annotate);
  }

  /* a 20px plus at the column's right edge, in a 32px target. */
  .explore-size {
    position: relative;
    width: 32px;
    height: 32px;
    margin-right: -6px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-strong);
    cursor: pointer;
    grid-column: 3;
    justify-self: end;
  }

  .explore-size-bar {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
  }

  .explore-size-bar.is-vertical {
    width: 1.5px;
    height: 16px;
  }

  .explore[data-size="few"] .explore-size-bar.is-vertical {
    display: none;
  }

  /* 4 per row (213px tiles) or 2 per row (450px), 24px apart, rows 48px apart. */
  .explore-grid {
    display: grid;
    margin: 0;
    padding: 0;
    gap: 48px 24px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
  }

  .explore[data-size="few"] .explore-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .explore-tile {
    display: block;
    color: var(--ink-strong);
  }

  .explore-visual {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .explore-code {
    display: block;
    margin-top: 16px;
    font: 13px / 17px var(--mono);
    text-align: center;
  }

  @media (max-width: 980px) {
    .explore {
      width: auto;
      margin-left: 0;
      padding-inline: 20px;
      padding-top: 40px;
    }
  }

  /* phones (figma 300:1850, 300:1959): the toggle at the left in mono 13, 20px apart; 2 per row (159px) or 1, 16px
     apart, rows 32px apart, codes 12px under the tile in mono 12. */
  @media (max-width: 760px) {
    :global(.nav-ready) .explore-bar {
      margin-bottom: 28px;
      grid-template-columns: 1fr auto;
    }

    .explore-toggle {
      grid-column: 1;
      gap: 20px;
    }

    .explore-toggle button,
    .explore-heading {
      font-size: 13px;
      line-height: 17px;
    }

    .explore-size {
      grid-column: 2;
    }

    .explore-grid {
      gap: 32px 16px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .explore[data-size="few"] .explore-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .explore-code {
      margin-top: 12px;
      font-size: 12px;
      line-height: 16px;
    }
  }

  /* the 375 frame puts the credit 40px under the last row, with the footer's 72px phone margin. */
  @media (max-width: 620px) {
    .explore {
      margin-bottom: -56px;
    }
  }
</style>
