---
// About v3 (figma 255:1842): the eyebrow over two paragraphs and the experience list, then education, interests and
// the four photo chapters, in the home page's 924px column beside the rail.
import AboutChapters from "@/components/AboutChapters.astro";
import Base from "@/layouts/Base.astro";
import { aboutChapters, aboutGallery, education, experience, interests, profile } from "@/data/portfolio.mjs";
---

<Base title="About" description={profile.aboutParagraphs[0]}>
  <article class="about-page">
    <header class="about-intro" data-reveal>
      <p class="about-eyebrow">About me</p>
      <h1 class="sr-only">About Kenneth Yeaher</h1>
      <div class="about-columns">
        <div class="about-copy">
          {profile.aboutParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          <p class="about-availability">{profile.availability}</p>
        </div>
        <section aria-labelledby="experience-title">
          <h2 id="experience-title" class="about-label">Experience</h2>
          <ol class="experience-list" role="list">
            {
              experience.map((row) => (
                <li class="experience-row">
                  <span class="experience-year">{row.year}</span>
                  <span class="experience-company">{row.organization}</span>
                  <span class="experience-role">{row.role}</span>
                </li>
              ))
            }
          </ol>
        </section>
      </div>
    </header>

    <section class="about-section" aria-labelledby="education-title" data-reveal>
      <h2 id="education-title" class="about-label">Education</h2>
      <div class="about-columns">
        {
          education.map((entry) => (
            <article class="degree">
              <h3>{entry.degree}</h3>
              <p class="degree-meta">
                {entry.school} · {entry.period}
              </p>
              <ul class="course-list" role="list">
                {entry.notableCourses.map((course) => (
                  <li>
                    <span class="course-code">{course.code}</span>
                    <span class="course-title">{course.title}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="about-section is-interests" aria-labelledby="interests-title" data-reveal>
      <h2 id="interests-title" class="about-label">Beyond the work</h2>
      <div class="interest-grid">
        {
          interests.map((interest) => (
            <article class="interest">
              <h3>{interest.name}</h3>
              <p>{interest.blurb}</p>
            </article>
          ))
        }
      </div>
    </section>

    <div class="about-rule" aria-hidden="true"></div>
    <AboutChapters chapters={aboutChapters} gallery={aboutGallery} />
  </article>
</Base>

<style>
  /* the home page's column (see index.astro): 924px, x=258 at 1440, clear of the rail. the footer's own margin and
     padding put the credit 120px under the last photo row. */
  .about-page {
    width: min(924px, 100% - 48px);
    margin-left: max(24px, (100% - 924px) / 2 - 48px);
  }

  /* the eyebrow at y=200, level with the rail; the paragraphs and the Experience label 25px under it. */
  .about-intro {
    padding-top: 136px;
  }

  .about-eyebrow {
    margin: 0 0 25px;
    color: var(--color-mark);
    font: 11px / 15px var(--mono);
    text-transform: uppercase;
  }

  /* two 450px columns 24px apart (x=258 and 732 at 1440). */
  .about-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  /* newsreader is self-hosted at weights 400 to 500, so the frame's semibold renders at 500 rather than a faux bold. */
  .about-copy p {
    max-width: 414px;
    margin: 0;
    color: var(--ink);
    font-family: var(--body);
    font-size: 18px;
    font-weight: 500;
    line-height: 28px;
  }

  .about-copy p + p {
    margin-top: 13px;
  }

  .about-copy p:nth-child(2) {
    max-width: 394px;
  }

  /* the frame's box is 367px, but geist in the browser needs 370 to break after "HCI" as figma does. */
  .about-copy p.about-availability {
    max-width: 372px;
    color: var(--muted);
    font: 15px / 22px var(--ui-sans);
  }

  /* section labels: geist 15, muted, 20px over what they name. global, so the Photos label in AboutChapters shares it. */
  .about-page :global(.about-label) {
    margin: 0 0 20px;
    color: var(--muted);
    font: 400 15px / 20px var(--ui-sans);
  }

  .about-intro .about-label {
    margin-bottom: 16px;
  }

  /* year, company and role on one grid, so every role starts 20px after the longest company name; rows 30px apart. */
  .experience-list {
    display: grid;
    margin: 0;
    padding: 0;
    grid-template-columns: 40px max-content minmax(0, 1fr);
    row-gap: 10px;
    list-style: none;
  }

  .experience-row {
    display: grid;
    align-items: baseline;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
  }

  .experience-year {
    color: var(--muted);
    font: 11px / 15px var(--mono);
  }

  .experience-company,
  .experience-role {
    font-family: var(--body);
    font-size: 14.5px;
    line-height: 20px;
  }

  .experience-company {
    color: var(--ink-strong);
  }

  /* the longest role runs past the 450px column, as it does in the frame, rather than wrap. */
  .experience-role {
    padding-left: 20px;
    color: var(--muted);
    white-space: nowrap;
  }

  /* each section opens on a rule 60px under the one before, its label 31px under the rule. */
  .about-section,
  .about-rule {
    margin-top: 60px;
    padding-top: 31px;
    border-top: 1px solid var(--rule);
  }

  .about-rule {
    margin-top: 64px;
  }

  .degree h3 {
    margin: 0;
    color: var(--ink-strong);
    font-family: var(--display);
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 30px;
  }

  .degree-meta {
    margin: 8px 0 0;
    color: var(--muted);
    font: 14px / 20px var(--ui-sans);
  }

  /* code in a 78px column, title in newsreader 15; rows 26px apart. */
  .course-list {
    display: grid;
    margin: 18px 0 0;
    padding: 0;
    gap: 6px;
    list-style: none;
  }

  .course-list li {
    display: grid;
    align-items: baseline;
    grid-template-columns: 78px minmax(0, 1fr);
  }

  .course-code {
    color: var(--muted);
    font: 11px / 15px var(--mono);
  }

  .course-title {
    color: var(--ink);
    font-family: var(--body);
    font-size: 15px;
    line-height: 20px;
  }

  /* three columns of text, no cards: 292px wide, 24px apart, rows 32px apart. */
  .interest-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px 24px;
  }

  .interest h3 {
    margin: 0;
    color: var(--ink-strong);
    font-family: var(--body);
    font-size: 17px;
    font-weight: 400;
    line-height: 24px;
  }

  .interest p {
    margin: 6px 0 0;
    color: var(--muted);
    font: 14px / 21px var(--ui-sans);
  }

  /* phones follow the home page: one column at a 20px margin. */
  @media (max-width: 980px) {
    .about-page {
      width: auto;
      margin-left: 0;
      padding-inline: 20px;
    }

    .about-intro {
      padding-top: 96px;
    }

    .about-columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .interest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .about-intro {
      padding-top: 76px;
    }

    .interest-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    /* the role drops under its company once the row cannot hold both. */
    .experience-list {
      grid-template-columns: 40px minmax(0, 1fr);
      row-gap: 12px;
    }

    .experience-role {
      grid-column: 2;
      padding-left: 0;
      white-space: normal;
    }
  }
</style>
