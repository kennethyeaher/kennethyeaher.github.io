---
// Contact page. A short invitation and a grid of ways to reach me.
import Base from "@/layouts/Base.astro";
import Card from "@/components/Card.astro";
import { profile } from "@/data/profile";

// The contact methods shown as cards. Order matters, email leads.
const contactMethods = [
  { label: "Email", value: profile.email, href: `mailto:${profile.email}` },
  { label: "LinkedIn", value: "Connect", href: profile.links.linkedin },
  { label: "GitHub", value: "@kennethyeaher", href: profile.links.github },
  { label: "Resume", value: "Download PDF", href: profile.links.resume },
];
---

<Base title="Contact">
  <section class="mx-auto max-w-3xl px-6 pb-20 pt-20">
    <h1 class="reveal font-display text-4xl font-semibold tracking-tight sm:text-5xl">
      Get in touch
    </h1>
    <p
      class="reveal mt-5 max-w-prose text-lg text-ink-muted dark:text-paper/60"
      style="transition-delay: 80ms"
    >
      I am open to conversations about venture, consulting, and data work. The fastest
      way to reach me is email.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        contactMethods.map((method, index) => (
          <a href={method.href} class="group block">
            <Card
              class="reveal p-6 transition-colors hover:border-accent"
              style={`transition-delay: ${index * 60}ms`}
            >
              <div class="text-sm text-ink-muted dark:text-paper/50">{method.label}</div>
              <div class="mt-1 break-all font-semibold group-hover:text-accent">
                {method.value}
              </div>
            </Card>
          </a>
        ))
      }
    </div>
  </section>
</Base>
