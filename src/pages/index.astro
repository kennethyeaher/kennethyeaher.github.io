---
// Work index: the thesis over Currently and Previously, then the project grid (home v3, figma 176:1721 and 177:1723).
import Base from "@/layouts/Base.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getFeaturedProjects, homeNow, profile } from "@/data/portfolio.mjs";

const projects = getFeaturedProjects();
---

<Base description={profile.intro}>
  <div class="home-page">
    <section class="home-intro" aria-labelledby="home-title">
      <div class="home-thesis" data-reveal>
        <h1 id="home-title">{profile.headline}</h1>
      </div>
      <dl class="home-now" data-reveal>
        <div class="home-now-currently">
          <dt>Currently</dt>
          <dd>{homeNow.currently.map((line) => <span>{line}</span>)}</dd>
        </div>
        <div class="home-now-previously">
          <dt>Previously</dt>
          <dd>{homeNow.previously}</dd>
        </div>
      </dl>
    </section>

    <section class="work" aria-labelledby="work-title">
      <div class="work-header">
        <h2 id="work-title">Selected work</h2>
        <p>{String(projects.length).padStart(2, "0")} projects</p>
      </div>
      <div class="work-grid">
        {
          projects.map((project) => (
            <ProjectCard project={project} />
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  /* above 980 a 924px column centred on the screen (x=258 at 1440), kept 120px from the left edge to clear the rail.
     main.beside-rail pads 96px on the left, so the centre sits 48px left of the middle of this box. */
  .home-page {
    width: min(924px, 100% - 48px);
    margin-left: max(24px, (100% - 924px) / 2 - 48px);
  }

  /* the thesis tops out at y=352 in the 1440 frame, level with the rail. */
  .home-intro {
    padding-top: 288px;
    padding-bottom: 96px;
  }

  .home-thesis h1 {
    margin: 0;
    color: var(--ink-strong);
    /* the h1's own metric matched fallbacks, sized for its desktop optical size (see global.css). */
    font-family: "Fraunces", "Fraunces Home Wide Fallback Iowan", "Fraunces Home Wide Fallback Georgia", var(--display);
    font-size: 72px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 74px;
  }

  /* geist 15/22, labels muted and text in ink; Currently 280px and Previously 470px, 48px apart. */
  .home-now {
    display: flex;
    margin: 48px 0 0;
    gap: 48px;
    font: 15px / 22px var(--ui-sans);
  }

  .home-now-currently {
    flex: 0 1 280px;
  }

  .home-now-previously {
    flex: 0 1 470px;
  }

  .home-now dt {
    color: var(--muted);
  }

  .home-now dd {
    margin: 6px 0 0;
    color: var(--ink);
  }

  .home-now dd span {
    display: block;
  }

  .work-header {
    display: flex;
    padding-bottom: 20px;
    justify-content: space-between;
    gap: 24px;
    color: var(--muted);
    font: 12px / 1.3 var(--mono);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .work-header h2,
  .work-header p {
    margin: 0;
    font: inherit;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 24px;
  }

  @media (max-width: 980px) {
    .home-page {
      width: auto;
      margin: 0;
      padding-inline: 20px;
    }

    .home-intro {
      padding-top: 96px;
      padding-bottom: 56px;
    }

    .home-now {
      flex-direction: column;
      margin-top: 32px;
      gap: 24px;
    }

    .home-now-currently,
    .home-now-previously {
      flex: none;
    }

    .home-now dd {
      margin-top: 4px;
    }
  }

  @media (max-width: 760px) {
    /* y=152 in the 375 frame. */
    .home-intro {
      padding-top: 76px;
    }

    .home-thesis h1 {
      font-family: "Fraunces", "Fraunces Home Small Fallback Iowan", "Fraunces Home Small Fallback Georgia", var(--display);
      font-size: 40px;
      line-height: 42px;
    }

    /* the mobile frame goes straight from Previously to the first card. */
    .work-header {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .work-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
</style>
