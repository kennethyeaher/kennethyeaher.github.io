---
// Work index: the thesis over Currently and Previously, then the project grid (home v3, figma 176:1721 and 177:1723).
import Base from "@/layouts/Base.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SpecimenFonts from "@/components/exhibits/specimens/SpecimenFonts.astro";
import { getFeaturedProjects, homeNow, profile } from "@/data/portfolio.mjs";
// the motion covers' figma timelines (scripts/build-cover-motion.mjs); no other page shows these cards.
import "@/styles/cover-motion/college-park-capstone.css";
import "@/styles/cover-motion/ovara.css";
import "@/styles/cover-motion/kairo-health.css";
import "@/styles/cover-motion/terpcarehub.css";

const projects = getFeaturedProjects();
---

<Base description={profile.intro}>
  {/* terpcarehub's motion cover is set in figtree (400, 500 and 600), so home declares the self-hosted cut too. */}
  <SpecimenFonts slot="head" fonts={["figtree"]} />
  <div class="home-page">
    <section class="home-intro" aria-labelledby="home-title">
      <div class="home-thesis" data-reveal>
        <h1 id="home-title">{profile.headline}</h1>
      </div>
      <dl class="home-now" data-reveal>
        <div class="home-now-currently">
          <dt>Currently</dt>
          <dd>{homeNow.currently.map((line) => <span>{line}</span>)}</dd>
        </div>
        <div class="home-now-previously">
          <dt>Previously</dt>
          {/* each "@" holds on to the word before it, so no line starts with one. */}
          <dd>{homeNow.previously.replaceAll(" @", "\u00a0@")}</dd>
        </div>
      </dl>
    </section>

    <section class="work" aria-labelledby="work-title">
      <h2 id="work-title" class="sr-only">Selected work</h2>
      <div class="work-grid">
        {
          projects.map((project) => (
            <ProjectCard project={project} />
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  /* above 980 a 924px column centred on the screen (x=258 at 1440), kept 120px from the left edge to clear the rail.
     main.beside-rail pads 96px on the left, so the centre sits 48px left of the middle of this box. the bottom margin
     collapses with the footer's 96px one, and the footer pads 24px above the credit, so the credit sits 140px under
     the grid. */
  .home-page {
    width: min(924px, 100% - 48px);
    margin-bottom: 116px;
    margin-left: max(24px, (100% - 924px) / 2 - 48px);
  }

  /* the thesis tops out at y=200 in the 1440 frame, level with the rail. */
  .home-intro {
    padding-top: 136px;
    padding-bottom: 96px;
  }

  .home-thesis h1 {
    margin: 0;
    color: var(--ink-strong);
    /* the h1's own metric matched fallbacks, sized for its desktop optical size (see global.css). */
    font-family: "Fraunces", "Fraunces Home Wide Fallback Iowan", "Fraunces Home Wide Fallback Georgia", var(--display);
    font-size: 72px;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 74px;
  }

  /* geist 15/22, labels muted and text in ink; Currently 280px and Previously 470px, 48px apart. */
  .home-now {
    display: flex;
    margin: 48px 0 0;
    gap: 48px;
    font: 15px / 22px var(--ui-sans);
  }

  .home-now-currently {
    flex: 0 1 280px;
  }

  .home-now-previously {
    flex: 0 1 470px;
  }

  .home-now dt {
    color: var(--muted);
  }

  .home-now dd {
    margin: 6px 0 0;
    color: var(--ink);
  }

  .home-now dd span {
    display: block;
  }

  /* two 454px columns 16px apart, rows 40px apart. */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 16px;
  }

  @media (max-width: 980px) {
    .home-page {
      width: auto;
      margin-left: 0;
      padding-inline: 20px;
    }

    .home-intro {
      padding-top: 96px;
      padding-bottom: 56px;
    }

    .home-now {
      flex-direction: column;
      margin-top: 32px;
      gap: 24px;
    }

    .home-now-currently,
    .home-now-previously {
      flex: none;
    }

    .home-now dd {
      margin-top: 4px;
    }
  }

  @media (max-width: 760px) {
    /* y=152 in the 375 frame. */
    .home-intro {
      padding-top: 76px;
    }

    .home-thesis h1 {
      font-family: "Fraunces", "Fraunces Home Small Fallback Iowan", "Fraunces Home Small Fallback Georgia", var(--display);
      font-size: 40px;
      line-height: 42px;
    }

    .work-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  /* the 375 frame puts the credit 80px under the last card: the footer's 72px phone margin less 16, and its 24px
     padding. */
  @media (max-width: 620px) {
    .home-page {
      margin-bottom: -16px;
    }
  }
</style>
