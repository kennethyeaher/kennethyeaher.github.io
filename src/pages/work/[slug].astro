---
// static, evidence-led case studies generated from one verified project model; every project uses the v2 exhibit layout.
import Base from "@/layouts/Base.astro";
import ExhibitCaseStudy from "@/components/exhibits/ExhibitCaseStudy.astro";
import {
  getAdjacentProject,
  getFeaturedProjects,
  projects,
} from "@/data/portfolio.mjs";

type ProjectRecord = (typeof projects)[number];

interface Props {
  project: ProjectRecord;
}

export function getStaticPaths() {
  return getFeaturedProjects().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const next = getAdjacentProject(project.slug, "next");
// every cover palette has at least two colours, and the reading progress test checks each page's fill.
const accent = ("accent" in project.cover ? project.cover.accent : project.cover.palette[1])!;
const accentDark = liftToContrast(accent, "#344553");

/** wcag relative luminance of a #rrggbb colour. */
function luminance(hex: string): number {
  const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
}

/** mix a colour toward white in 1% steps until it reaches 3:1 against a background (the dark --rule track). */
function liftToContrast(hex: string, background: string): string {
  const channels = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
  for (let mix = 0; mix <= 100; mix++) {
    const lifted = `#${channels.map((c) => Math.round(c + ((255 - c) * mix) / 100).toString(16).padStart(2, "0")).join("")}`;
    const [high, low] = [luminance(lifted), luminance(background)].sort((x, y) => y - x);
    if ((high + 0.05) / (low + 0.05) >= 3) return lifted;
  }
  return "#ffffff";
}
---

<Base title={project.title} description={project.summary} image={`/images/social/${project.slug}.png`} imageAlt={`${project.title}, ${project.role}, ${project.year}`}>
  <div class="reading-progress" data-reading-progress aria-hidden="true" style={`--reading-accent: ${accent}; --reading-accent-dark: ${accentDark}`}><span></span></div>
  <ExhibitCaseStudy project={project} next={next} />
</Base>
