---
// static, evidence-led case studies generated from one verified project model; every project uses the v2 exhibit layout.
import Base from "@/layouts/Base.astro";
import ExhibitCaseStudy from "@/components/exhibits/ExhibitCaseStudy.astro";
import SpecimenFonts from "@/components/exhibits/specimens/SpecimenFonts.astro";
import { fontsForProject } from "@/components/exhibits/specimens/fonts.mjs";
import {
  getAdjacentProject,
  getFeaturedProjects,
  projects,
} from "@/data/portfolio.mjs";
import { liftToContrast } from "@/utils/oklch.mjs";
// elms's loop timelines (scripts/build-cover-motion.mjs), linked only on the page that shows the loops.
import courseFirstCss from "@/styles/cover-motion/elms-course-first.css?url";
import undoCss from "@/styles/cover-motion/elms-undo.css?url";
import sendPathCss from "@/styles/cover-motion/elms-send-path.css?url";

type ProjectRecord = (typeof projects)[number];

interface Props {
  project: ProjectRecord;
}

export function getStaticPaths() {
  return getFeaturedProjects().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const next = getAdjacentProject(project.slug, "next");
// every cover palette has at least two colours, and the reading progress test checks each page's fill.
const accent = ("accent" in project.cover ? project.cover.accent : project.cover.palette[1])!;
// the dark track is #344553 (--rule in the dark theme).
const accentDark = liftToContrast(accent, "#344553");
// the live specimens' fonts, declared only on the pages that show one.
const specimenFonts = fontsForProject(project);
// the html loops' timelines, by loop key, linked only where a loop card plays one.
const loopStyles: Record<string, string> = { "elms-course-first": courseFirstCss, "elms-undo": undoCss, "elms-send-path": sendPathCss };
const loopKeys = (project.exhibits ?? []).flatMap((exhibit) => [...("loops" in exhibit ? exhibit.loops?.visuals ?? [] : []), ...("part" in exhibit ? exhibit.part?.loops.visuals ?? [] : [])])
  .flatMap(({ loop }) => (loop && "motion" in loop ? [loop.motion] : []));

---

<Base title={project.title} description={project.summary} image={`/images/social/${project.slug}.png`} imageAlt={`${project.title}, ${project.role}, ${project.year}`} crumb={project.title}>
  {specimenFonts.length > 0 && <SpecimenFonts slot="head" fonts={specimenFonts} />}
  {[...new Set(loopKeys)].map((key) => <link slot="head" rel="stylesheet" href={loopStyles[key]} />)}
  <div class="reading-progress" data-reading-progress aria-hidden="true" style={`--reading-accent: ${accent}; --reading-accent-dark: ${accentDark}`}><span></span></div>
  <ExhibitCaseStudy project={project} next={next} />
</Base>
